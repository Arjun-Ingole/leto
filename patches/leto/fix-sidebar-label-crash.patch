+// The site pill's text button. The sidebar paints to a layer that isn't
+// opaque, so, as with the sidebar's other buttons, its text can't use subpixel
+// rendering.
+class SiteButton : public views::LabelButton {
+  METADATA_HEADER(SiteButton, views::LabelButton)
+
+ public:
+  explicit SiteButton(PressedCallback callback)
+      : views::LabelButton(std::move(callback), std::u16string()) {
+    label()->SetSubpixelRenderingEnabled(false);
+    label()->SetSkipSubpixelRenderingOpacityCheck(true);
+  }
+};
+
+BEGIN_METADATA(SiteButton)
+END_METADATA
