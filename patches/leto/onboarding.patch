+<script lang="ts">
+    // Leto's backdrop: graphite (or paper, in light mode) lit from above by a
+    // soft moonlight glow, under a fine film grain, like the app icon.
+
+    type Props = { dimmed?: boolean };
+    const { dimmed = false }: Props = $props();
+
+    let pulsing = $state(false);
+    let timer: number | undefined;
+
+    // Brightens the glow for a moment as the flow moves forward.
+    export const emphasize = () => {
+        pulsing = false;
+        window.clearTimeout(timer);
+        requestAnimationFrame(() => {
+            pulsing = true;
+            timer = window.setTimeout(() => (pulsing = false), 1400);
+        });
+    };
+
+    const grain =
+        "data:image/svg+xml;utf8," +
+        encodeURIComponent(
+            `<svg xmlns="http://www.w3.org/2000/svg" width="220" height="220">` +
+                `<filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/>` +
+                `<feColorMatrix type="saturate" values="0"/></filter>` +
+                `<rect width="100%" height="100%" filter="url(#n)"/></svg>`
+        );
+</script>
+
+<div class="backdrop" class:dimmed class:pulsing aria-hidden="true">
+    <div class="glow"></div>
+    <div class="glow secondary"></div>
+    <div class="grain" style:background-image={`url("${grain}")`}></div>
+</div>
+
+<style>
+    .backdrop {
+        position: fixed;
+        inset: 0;
+        z-index: 0;
+        overflow: hidden;
+        pointer-events: none;
+        background:
+            radial-gradient(
+                120% 80% at 50% 0% in oklab,
+                var(--bg-gradient-start) 0%,
+                var(--bg-surface) 60%
+            ),
+            linear-gradient(
+                180deg in oklab,
+                var(--bg-gradient-start),
+                var(--bg-gradient-end)
+            );
+        animation: backdrop-in 1.2s var(--ease-out) both;
+    }
+
+    /* The moonlight: a wide radial glow eased over many stops and mixed in
+       Oklab so it fades without banding, drawn once and only moved by the
