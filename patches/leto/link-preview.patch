+
+class BrowserWindowInterface;
+
+namespace content {
+struct OpenURLParams;
+}  // namespace content
+
+namespace leto {
+
+// Link previews, like Arc's Peek and Zen's Glance: Shift-clicking a link opens
+// it in a card floating over the page instead of a new window. The card can be
+// kept as a tab or put in split view, and Escape or clicking outside it closes
+// it.
+
+// Shows the page `params` opens in a preview over `browser`'s page. Returns
+// false if it doesn't, in which case the link should open as usual.
+bool ShowLinkPreview(BrowserWindowInterface* browser,
+                     const content::OpenURLParams& params);
+
+}  // namespace leto
