+// The preview: a card with the page's address and actions over the page. It
+// owns the previewed page until the card closes or hands the page to the tab
+// strip, and deletes itself once its window is gone.
+class LinkPreview : public content::WebContentsDelegate,
+                    public content::WebContentsObserver,
+                    public views::WidgetObserver {
+ public:
+  LinkPreview(BrowserView* browser_view, const content::OpenURLParams& params);
+  LinkPreview(const LinkPreview&) = delete;
+  LinkPreview& operator=(const LinkPreview&) = delete;
+  ~LinkPreview() override;
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  // Moves the page into the tab strip next to the active tab, in a split view
+  // with it when `split` is set, and closes the card.
+  void Promote(bool split);
+  void Close();
+  void OnCloseRequested(views::Widget::ClosedReason reason);
+
+  raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<content::WebContents> contents_;
+  // Must outlive `widget_`.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  raw_ptr<views::Label> host_label_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      widget_observation_{this};
+  bool closing_ = false;
+  base::WeakPtrFactory<LinkPreview> weak_factory_{this};
+};
+
+LinkPreview::LinkPreview(BrowserView* browser_view,
+                         const content::OpenURLParams& params)
+    : browser_view_(browser_view) {
+  Profile* profile = browser_view->browser()->GetProfile();
+  contents_ =
+      content::WebContents::Create(content::WebContents::CreateParams(profile));
+  // The page works as it would in a tab, with ad blocking, history and its
+  // icon, and is ready to become one.
+  TabHelpers::AttachTabHelpers(contents_.get());
+  contents_->SetDelegate(this);
+  Observe(contents_.get());
+  contents_->GetController().LoadURLWithParams(
+      content::NavigationController::LoadURLParams(params));
+
+  // Centred over the page, as large as most of it.
+  const gfx::Rect page_bounds =
+      browser_view->contents_container()->GetBoundsInScreen();
+  const gfx::Size size(static_cast<int>(page_bounds.width() * kSizeFraction),
+                       static_cast<int>(page_bounds.height() * kSizeFraction));
+
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      views::BubbleAnchor(), views::BubbleBorder::FLOAT,
+      views::BubbleBorder::STANDARD_SHADOW);
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetShowCloseButton(false);
+  delegate_->set_margins(gfx::Insets());
+  delegate_->set_corner_radius(kCornerRadius);
+  delegate_->SetBackgroundColor(kColorOmniboxResultsBackground);
+  delegate_->set_parent_window(browser_view->GetWidget()->GetNativeView());
+  delegate_->set_fixed_width(size.width());
+  delegate_->SetAnchorRect(page_bounds);
+
+  auto card = std::make_unique<views::View>();
+  card->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  auto* header = card->AddChildView(std::make_unique<views::View>());
+  header->SetLayoutManager(std::make_unique<views::FlexLayout>())
+      ->SetOrientation(views::LayoutOrientation::kHorizontal)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetInteriorMargin(gfx::Insets::VH(0, kHeaderPadding))
+      .SetDefault(views::kMarginsKey, gfx::Insets::VH(0, 2));
+  header->SetPreferredSize(gfx::Size(size.width(), kHeaderHeight));
+  host_label_ = header->AddChildView(
+      std::make_unique<views::Label>(DisplayHost(params.url)));
+  host_label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  host_label_->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+  host_label_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  host_label_->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 6, 0, 2));
+  header->AddChildView(MakeHeaderButton(
+      kSplitSceneIcon, kOpenInSplit,
+      base::BindRepeating(&LinkPreview::Promote, base::Unretained(this),
+                          /*split=*/true)));
+  header->AddChildView(MakeHeaderButton(
+      kOpenInFullIcon, kOpenAsTab,
+      base::BindRepeating(&LinkPreview::Promote, base::Unretained(this),
+                          /*split=*/false)));
+  header->AddChildView(MakeHeaderButton(
+      vector_icons::kCloseIcon, kClose,
+      base::BindRepeating(&LinkPreview::Close, base::Unretained(this))));
+
+  web_view_ = card->AddChildView(std::make_unique<views::WebView>(profile));
+  web_view_->SetPreferredSize(
+      gfx::Size(size.width(), size.height() - kHeaderHeight));
+  web_view_->SetWebContents(contents_.get());
+  delegate_->SetContentsView(std::move(card));
+  delegate_->SetInitiallyFocusedView(web_view_);
+
+  widget_ = views::BubbleDialogDelegate::CreateBubble(delegate_.get());
+  widget_observation_.Observe(widget_.get());
+  // Requests to close the card (Escape, clicking elsewhere) go through
+  // Close(), which also deletes this.
+  widget_->MakeCloseSynchronous(base::BindOnce(&LinkPreview::OnCloseRequested,
+                                               weak_factory_.GetWeakPtr()));
+  widget_->Show();
+}
+
+LinkPreview::~LinkPreview() {
+  Observe(nullptr);
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+  }
+  web_view_ = nullptr;
+  host_label_ = nullptr;
+  widget_observation_.Reset();
+  widget_.reset();
+  if (contents_) {
+    contents_->SetDelegate(nullptr);
+    contents_.reset();
+  }
+}
+
+content::WebContents* LinkPreview::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  switch (params.disposition) {
+    case WindowOpenDisposition::CURRENT_TAB:
+    case WindowOpenDisposition::NEW_WINDOW:
+      // Links followed in the preview, Shift-clicked ones included, stay in it.
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    default:
+      // New tabs open in the browser as they would from the page.
+      browser_view_->browser()->OpenGURL(params.url, params.disposition);
+      return nullptr;
+  }
+}
+
+content::WebContents* LinkPreview::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // Pages the preview opens, like target=_blank links, become tabs.
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  content::WebContents* raw = new_contents.get();
+  model->InsertWebContentsAt(model->active_index() + 1, std::move(new_contents),
+                             AddTabTypes::ADD_ACTIVE);
+  return raw;
+}
+
+content::KeyboardEventProcessingResult LinkPreview::PreHandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown &&
+      event.windows_key_code == ui::VKEY_ESCAPE) {
+    Close();
+    return content::KeyboardEventProcessingResult::HANDLED;
+  }
+  return content::KeyboardEventProcessingResult::NOT_HANDLED;
+}
+
+void LinkPreview::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && handle->HasCommitted() && host_label_) {
+    host_label_->SetText(DisplayHost(handle->GetURL()));
+  }
+}
+
+void LinkPreview::OnWidgetDestroying(views::Widget* widget) {
+  // The browser window is closing and took the card with it.
+  widget_observation_.Reset();
+  web_view_ = nullptr;
+  host_label_ = nullptr;
+  if (!closing_) {
+    closing_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+}
+
+void LinkPreview::Promote(bool split) {
+  if (closing_ || !contents_) {
+    return;
+  }
+  Observe(nullptr);
+  web_view_->SetWebContents(nullptr);
+  contents_->SetDelegate(nullptr);
+
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  tabs::TabInterface* active = model->GetActiveTab();
+  const bool can_split = split && active && !active->IsSplit();
+  content::WebContents* page = contents_.get();
+  const int index = model->InsertWebContentsAt(
+      model->active_index() + 1, std::move(contents_),
+      can_split ? AddTabTypes::ADD_NONE : AddTabTypes::ADD_ACTIVE);
+  if (can_split) {
+    model->AddToNewSplit(
+        {index},
+        split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+        split_tabs::SplitTabCreatedSource::kLinkClick);
+    // Splitting may move tabs, so find the page again.
+    model->ActivateTabAt(model->GetIndexOfWebContents(page));
+  }
+  Close();
+}
+
+void LinkPreview::Close() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  if (widget_) {
+    widget_->Hide();
+  }
+  // The page and the card's window go once the current event is handled.
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+}
+
+void LinkPreview::OnCloseRequested(views::Widget::ClosedReason reason) {
+  Close();
+}
+
+bool ShowLinkPreview(BrowserWindowInterface* browser,
+                     const content::OpenURLParams& params) {
+  if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget() ||
+      !browser_view->contents_container()) {
+    return false;
+  }
+  // Deletes itself when closed.
+  new LinkPreview(browser_view, params);
+  return true;
+}
