+bool SwitchToSpaceOnScreen(const base::FilePath& profile_path) {
+  BrowserWindowInterface* shown = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        BrowserWindow* window = BrowserWindow::FromBrowser(browser);
+        if (browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+            !browser->GetProfile()->IsOffTheRecord() && window &&
+            window->IsVisible()) {
+          shown = browser;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  if (!shown) {
+    return false;
+  }
+  if (shown->GetProfile()->GetPath() == profile_path) {
+    BrowserWindow::FromBrowser(shown)->Activate();
+  } else {
+    SwitchToSpace(shown, profile_path);
+  }
+  return true;
+}
