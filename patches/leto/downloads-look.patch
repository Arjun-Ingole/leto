 void DownloadDialogView::AddHeader() {
+#if BUILDFLAG(IS_MAC)
+  // Leto: a quiet header in the style of the site controls, with the full
+  // history a click away instead of in a footer.
+  {
+    auto* header = AddChildView(std::make_unique<views::FlexLayoutView>());
+    header->SetOrientation(views::LayoutOrientation::kHorizontal);
+    header->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    header->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::TLBR(2, 20, 4, 14)));
+
+    auto* title =
+        header->AddChildView(std::make_unique<views::Label>(u"Downloads"));
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title->SetEnabledColor(ui::kColorSysOnSurface);
+    title->SetFontList(
+        title->font_list().DeriveWithSizeDelta(1).DeriveWithWeight(
+            gfx::Font::Weight::SEMIBOLD));
+    title->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+
+    auto* show_all = header->AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&DownloadDialogView::ShowAllDownloads,
+                            base::Unretained(this)),
+        u"Show all"));
+    show_all->SetEnabledTextColors(ui::kColorSysOnSurfaceSubtle);
+    show_all->SetLabelStyle(views::style::STYLE_BODY_5);
+    show_all->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(2, 6)));
+    show_all->SetMinSize(gfx::Size());
+    show_all->SetTooltipText(
+        l10n_util::GetStringUTF16(IDS_DOWNLOAD_BUBBLE_FOOTER_TOOLTIP_LABEL));
+    views::InkDrop::Get(show_all)->SetMode(views::InkDropHost::InkDropMode::ON);
+    show_all->SetHasInkDropActionOnClick(true);
+    views::InkDrop::Get(show_all)->SetBaseColor(ui::kColorSysOnSurface);
+    views::InkDrop::Get(show_all)->SetHighlightOpacity(0.06f);
+    views::InstallRoundRectHighlightPathGenerator(show_all, gfx::Insets(), 6);
+    close_button_ = show_all;
+  }
+#else
   auto* header = AddChildView(std::make_unique<views::FlexLayoutView>());
   header->SetOrientation(views::LayoutOrientation::kHorizontal);
   header->SetBorder(views::CreateEmptyBorder(GetLayoutInsets(DOWNLOAD_ROW)));
