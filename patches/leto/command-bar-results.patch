+void CommandBarView::UpdateInputIcon(const AutocompleteMatch* top_match) {
+  // The field takes the top result's site icon when it leads to a page, and
+  // the search icon otherwise.
+  GURL url;
+  if (top_match && !AutocompleteMatch::IsSearchType(top_match->type) &&
+      top_match->destination_url.is_valid()) {
+    url = top_match->destination_url.GetWithEmptyPath();
+  }
+  if (url == input_icon_url_) {
+    return;
+  }
+  input_icon_url_ = url;
+  input_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+      vector_icons::kSearchIcon, kColorOmniboxResultsIcon, kInputIconSize));
+  if (url.is_empty()) {
+    return;
+  }
+  gfx::Image favicon = favicon_cache_.GetFaviconForPageUrl(
+      url,
+      base::BindOnce(
+          [](base::WeakPtr<CommandBarView> view, const GURL& url,
+             const gfx::Image& image) {
+            if (view && view->input_icon_url_ == url) {
+              view->input_icon_->SetImage(ui::ImageModel::FromImage(image));
+            }
+          },
+          weak_factory_.GetWeakPtr(), url));
+  if (!favicon.IsEmpty()) {
+    input_icon_->SetImage(ui::ImageModel::FromImage(favicon));
+  }
+}
