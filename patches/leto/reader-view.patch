+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_LETO_READER_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_LETO_READER_VIEW_H_
+
+class BrowserWindowInterface;
+
+namespace leto {
+
+// Reader view, as in Safari: the active tab's article shown on its own, in a
+// clean, readable layout with a choice of theme and font, using Chromium's
+// DOM distiller. Opened with Cmd+Option+R or from the site controls.
+
+// Shows the active tab in reader view, or the original page if it is in
+// reader view already.
+void ToggleReaderView(BrowserWindowInterface* browser);
+
+}  // namespace leto
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LETO_READER_VIEW_H_
