+
+/* Leto: a calm reader in the browser's style, using the system's fonts. These
+ * rules come last so they take precedence over Chromium's defaults. */
+
+.sans-serif {
+  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
+}
+
+.serif {
+  font-family: ui-serif, 'New York', 'Iowan Old Style', Charter, Georgia,
+      serif;
+}
+
+.monospace {
+  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
+}
+
+.light {
+  --leto-accent: #2156c4;
+  --leto-rule: rgba(29, 29, 31, .1);
+  --leto-wash: rgba(29, 29, 31, .04);
+  background-color: #fbfbfa;
+  color: #1d1d1f;
+}
+
+.sepia {
+  --leto-accent: #8a4a14;
+  --leto-rule: rgba(63, 49, 34, .14);
+  --leto-wash: rgba(63, 49, 34, .05);
+  background-color: #f6efe2;
+  color: #3f3122;
+}
+
+.dark {
+  --leto-accent: #8fb5ff;
+  --leto-rule: rgba(255, 255, 255, .12);
+  --leto-wash: rgba(255, 255, 255, .05);
+  background-color: #1c1c1e;
+  color: #e6e6e9;
+}
+
+.light a:link,
+.light a:visited,
+.sepia a:link,
+.sepia a:visited,
+.dark a:link,
+.dark a:visited {
+  color: var(--leto-accent);
+  text-decoration: none;
+}
+
+#content a:hover {
+  text-decoration: underline;
+  text-underline-offset: 2px;
+}
+
+#main-content {
+  padding: 0 1.5em;
+  width: 38em;
+}
+
+#settings-container {
+  border-bottom: none;
+  height: 40px;
+  margin-top: 12px;
+}
+
+#settings-container button {
+  color: inherit;
+  opacity: .6;
+}
+
+#settings-container button:hover {
+  background-color: var(--leto-wash);
+  opacity: 1;
+}
+
+#settings-container button#settings-toggle {
+  border-radius: 8px;
+  height: 32px;
+  padding: 0 10px;
+}
+
+.leto-aa {
+  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
+  font-size: 15px;
+  font-weight: 600;
+  letter-spacing: -.01em;
+}
+
+#settings-dialog {
+  border-radius: 12px;
+  box-shadow: 0 0 0 1px rgba(0, 0, 0, .06), 0 12px 32px rgba(0, 0, 0, .18);
+  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
+}
+
+.dark #settings-dialog {
+  background-color: #2c2c2e;
+  color: #e6e6e9;
+}
+
+.checkmark {
+  color: var(--leto-accent);
+}
+
+#main-content #article-header {
+  margin-bottom: .5em;
+  margin-top: 1.5em;
+}
+
+#main-content h1#title-holder {
+  font-size: 2.1em;
+  font-weight: 700;
+  letter-spacing: -.02em;
+  line-height: 1.15;
+}
+
+#content {
+  line-height: 1.65;
+}
+
+#content p {
+  margin: 0 0 1.1em;
+}
+
+#content h2,
+#content h3,
+#content h4 {
+  letter-spacing: -.01em;
+  line-height: 1.3;
+  margin: 1.8em 0 .6em;
+}
+
+#content img,
+#content video,
+#content figure img {
+  border-radius: 10px;
+  height: auto;
+  max-width: 100%;
+}
+
+#content figure {
+  margin: 1.6em 0;
+}
+
+#content figcaption,
+#content .caption {
+  font-size: .85em;
+  line-height: 1.45;
+  margin-top: .5em;
+  opacity: .65;
+}
+
+#content blockquote {
+  border-left: 3px solid var(--leto-rule);
+  margin: 1.4em 0;
+  padding: 0 0 0 1.1em;
+}
+
+#content hr {
+  background: var(--leto-rule);
+  border: none;
+  height: 1px;
+  margin: 2em 0;
+}
+
+#content pre,
+#content code {
+  background: var(--leto-wash);
+  border-radius: 6px;
+  font-size: .9em;
+}
+
+#content pre {
+  padding: .9em 1em;
+}
+
+#content code {
+  padding: .1em .3em;
+}
+
+#content pre code {
+  background: none;
+  padding: 0;
+}
+
+/* Tables read as plain rows rather than shaded boxes. */
+.light tbody tr:nth-child(odd),
+.sepia tbody tr:nth-child(odd),
+.dark tbody tr:nth-child(odd) {
+  background: none;
+}
+
+.light td,
+.sepia td,
+.dark td {
+  border: none;
+}
+
+#content tr {
+  border-bottom: 1px solid var(--leto-rule);
+}
+
+#content th,
+#content td {
+  padding: .5em .75em;
+}
