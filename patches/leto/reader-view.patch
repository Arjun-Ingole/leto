+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/leto/reader_view.h"
+
+#include <string>
+
+#include "base/functional/callback_helpers.h"
+#include "chrome/browser/dom_distiller/tab_utils.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/dom_distiller/core/url_utils.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace leto {
+
+void ToggleReaderView(BrowserWindowInterface* browser) {
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    return;
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  if (!dom_distiller::url_utils::IsDistilledPage(url)) {
+    if (dom_distiller::url_utils::IsUrlDistillable(url)) {
+      DistillCurrentPageAndViewIfSuccessful(contents, base::DoNothing());
+    }
+    return;
+  }
+
+  // Leave reader view the way it was entered when possible, so the page keeps
+  // its place in history.
+  const GURL original =
+      dom_distiller::url_utils::GetOriginalUrlFromDistillerUrl(url);
+  content::NavigationController& controller = contents->GetController();
+  if (controller.CanGoBack()) {
+    content::NavigationEntry* previous =
+        controller.GetEntryAtOffset(/*offset=*/-1);
+    if (previous && previous->GetURL() == original) {
+      controller.GoBack();
+      return;
+    }
+  }
+  if (original.is_valid()) {
+    controller.LoadURL(original, content::Referrer(),
+                       ui::PAGE_TRANSITION_LINK, std::string());
+  }
+}
+
+}  // namespace leto
