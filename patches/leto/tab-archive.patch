+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_LETO_TAB_ARCHIVER_H_
+#define CHROME_BROWSER_UI_VIEWS_LETO_TAB_ARCHIVER_H_
+
+namespace leto {
+
+// Archives tabs that haven't been looked at for a while, as Arc does, so the
+// sidebar keeps only what is in use. Pinned tabs, tabs in groups or split
+// views, the active tab and tabs playing media are kept. Archived tabs are
+// closed into history, so they can be found from the command bar and reopened
+// with Cmd+Shift+T. The delay is the kLetoArchiveTabsAfterHours pref.
+
+// Starts checking every space's tabs periodically. Safe to call more than once.
+void StartTabArchiver();
+
+}  // namespace leto
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LETO_TAB_ARCHIVER_H_
