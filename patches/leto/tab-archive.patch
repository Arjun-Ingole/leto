+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/leto/tab_archiver.h"
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+
+namespace leto {
+
+namespace {
+
+// How often tabs are checked. Archiving is not time critical, so this is long
+// enough to cost nothing.
+constexpr base::TimeDelta kCheckInterval = base::Minutes(10);
+
+bool ShouldArchive(TabStripModel* model, int index, base::Time cutoff) {
+  if (index == model->active_index() || model->IsTabPinned(index) ||
+      model->GetTabGroupForTab(index) || model->GetSplitForTab(index)) {
+    return false;
+  }
+  content::WebContents* contents = model->GetWebContentsAt(index);
+  return contents && !contents->IsCurrentlyAudible() &&
+         !contents->HasPictureInPictureVideo() &&
+         contents->GetLastActiveTime() < cutoff;
+}
+
+void ArchiveTabs(BrowserWindowInterface* browser) {
+  if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      browser->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  const int hours = browser->GetProfile()->GetPrefs()->GetInteger(
+      prefs::kLetoArchiveTabsAfterHours);
+  if (hours <= 0) {
+    return;
+  }
+  const base::Time cutoff = base::Time::Now() - base::Hours(hours);
+  TabStripModel* model = browser->GetTabStripModel();
+  // From the end, so that closing a tab doesn't shift the ones still to check.
+  for (int index = model->count() - 1; index >= 0; --index) {
+    if (ShouldArchive(model, index, cutoff)) {
+      model->CloseWebContentsAt(index,
+                                TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+}
+
+void ArchiveAllSpaces() {
+  // Every space has its own window, shown or hidden, so this covers them all.
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [](BrowserWindowInterface* browser) {
+        ArchiveTabs(browser);
+        return true;
+      });
+}
+
+}  // namespace
+
+void StartTabArchiver() {
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  if (!timer->IsRunning()) {
+    timer->Start(FROM_HERE, kCheckInterval,
+                 base::BindRepeating(&ArchiveAllSpaces));
+  }
+}
+
+}  // namespace leto
