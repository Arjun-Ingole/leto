+void UpdateTabDragFeedback(views::View* tab_strip_view,
+                           const gfx::Point& point_in_screen,
+                           bool dragging_pinned) {
+  TabStripView* tab_strip = AsTabStrip(tab_strip_view);
+  if (!tab_strip || !GetSidebar(tab_strip_view)) {
+    return;
+  }
+  const DropTarget target =
+      GetDropTarget(tab_strip_view, point_in_screen, dragging_pinned);
+
+  if (SpaceBarView* space_bar = GetSpaceBar(tab_strip_view)) {
+    space_bar->SetDropTarget(target.action == DropAction::kMoveToSpace
+                                 ? std::optional<base::FilePath>(target.space)
+                                 : std::nullopt);
+  }
+
+  if (target.action != DropAction::kPin &&
+      target.action != DropAction::kUnpin) {
+    if (DropIndicator* indicator = GetIndicator(tab_strip, /*create=*/false);
+        indicator && indicator->GetVisible()) {
+      indicator->SetVisible(false);
+    }
+    return;
+  }
+
+  DropIndicator* indicator = GetIndicator(tab_strip, /*create=*/true);
+  const gfx::Rect pinned = tab_strip->pinned_tabs_scroll_view()->bounds();
+  const gfx::Rect unpinned = tab_strip->unpinned_tabs_scroll_view()->bounds();
+  if (target.action == DropAction::kPin && !pinned.IsEmpty()) {
+    // Outline the pinned tabs, which the dropped tabs join.
+    gfx::Rect bounds = pinned;
+    bounds.Outset(gfx::Outsets::VH(2, 0));
+    bounds.Inset(gfx::Insets::VH(0, kIndicatorInset));
+    indicator->ShowAt(bounds, u"");
+    return;
+  }
+  // With no pinned tabs yet, or when unpinning, a band at the top of the other
+  // tabs says what the drop will do.
+  gfx::Rect bounds(unpinned.x(), unpinned.y(), unpinned.width(),
+                   kIndicatorHeight);
+  bounds.Inset(gfx::Insets::VH(0, kIndicatorInset));
+  indicator->ShowAt(bounds, target.action == DropAction::kPin
+                                ? u"Drop to pin"
+                                : u"Drop to unpin");
+}
+
+void ClearTabDragFeedback(views::View* tab_strip_view) {
+  TabStripView* tab_strip = AsTabStrip(tab_strip_view);
+  if (!tab_strip) {
+    return;
+  }
+  if (DropIndicator* indicator = GetIndicator(tab_strip, /*create=*/false)) {
+    indicator->SetVisible(false);
+  }
+  if (SpaceBarView* space_bar = GetSpaceBar(tab_strip_view)) {
+    space_bar->SetDropTarget(std::nullopt);
+  }
+}
+
+void HandleTabsDropped(views::View* tab_strip_view,
+                       const gfx::Point& point_in_screen,
+                       const std::vector<content::WebContents*>& contents,
+                       bool dragging_pinned) {
+  const DropTarget target =
+      GetDropTarget(tab_strip_view, point_in_screen, dragging_pinned);
+  if (target.action == DropAction::kNone || contents.empty() ||
+      !tab_strip_view->GetWidget()) {
+    return;
+  }
+  BrowserView* browser_view = BrowserView::GetBrowserViewForNativeWindow(
+      tab_strip_view->GetWidget()->GetNativeWindow());
+  if (!browser_view) {
+    return;
+  }
+  std::vector<base::WeakPtr<content::WebContents>> tabs;
+  for (content::WebContents* web_contents : contents) {
+    tabs.push_back(web_contents->GetWeakPtr());
+  }
+  // The drag finishes its own moves first.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ApplyDrop, browser_view->browser()->GetWeakPtr(),
+                     std::move(tabs), target));
+}
