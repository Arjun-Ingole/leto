+
+TabStripView* AsTabStrip(views::View* view) {
+  return view ? views::AsViewClass<TabStripView>(view) : nullptr;
+}
+
+// Only the sidebar takes part; horizontal tab strips are left alone.
+VerticalTabStripRegionView* GetSidebar(views::View* tab_strip) {
+  for (views::View* view = tab_strip; view; view = view->parent()) {
+    if (auto* region = views::AsViewClass<VerticalTabStripRegionView>(view)) {
+      return region;
+    }
+  }
+  return nullptr;
+}
+
+SpaceBarView* GetSpaceBar(views::View* tab_strip) {
+  VerticalTabStripRegionView* sidebar = GetSidebar(tab_strip);
+  VerticalTabStripBottomContainer* footer =
+      sidebar ? sidebar->GetBottomContainer() : nullptr;
+  views::View* space_bar = footer ? footer->space_bar() : nullptr;
+  return space_bar ? views::AsViewClass<SpaceBarView>(space_bar) : nullptr;
+}
+
+DropIndicator* GetIndicator(TabStripView* tab_strip, bool create) {
+  for (views::View* child : tab_strip->children()) {
+    if (auto* indicator = views::AsViewClass<DropIndicator>(child)) {
+      return indicator;
+    }
+  }
+  return create ? tab_strip->AddChildView(std::make_unique<DropIndicator>())
+                : nullptr;
+}
+
+DropTarget GetDropTarget(views::View* tab_strip_view,
+                         const gfx::Point& point_in_screen,
+                         bool dragging_pinned) {
+  TabStripView* tab_strip = AsTabStrip(tab_strip_view);
+  VerticalTabStripRegionView* sidebar = GetSidebar(tab_strip_view);
+  if (!tab_strip || !sidebar ||
+      !sidebar->GetBoundsInScreen().Contains(point_in_screen)) {
+    return {};
+  }
+  if (SpaceBarView* space_bar = GetSpaceBar(tab_strip_view)) {
+    if (std::optional<base::FilePath> space =
+            space_bar->GetOtherSpaceAt(point_in_screen)) {
+      return {DropAction::kMoveToSpace, *space};
+    }
+  }
+  const int unpinned_top =
+      tab_strip->unpinned_tabs_scroll_view()->GetBoundsInScreen().y();
+  if (!dragging_pinned && point_in_screen.y() < unpinned_top) {
+    return {DropAction::kPin};
+  }
+  if (dragging_pinned && point_in_screen.y() >= unpinned_top) {
+    return {DropAction::kUnpin};
+  }
+  return {};
+}
+
+// Moves the pages of `contents` to the Space at `space`, which then comes on
+// screen. Pages can't move between profiles, so they open afresh there, and
+// pinned tabs stay pinned.
+void MoveToSpace(BrowserWindowInterface* browser,
+                 const std::vector<base::WeakPtr<content::WebContents>>& tabs,
+                 const base::FilePath& space) {
+  std::vector<std::pair<GURL, bool>> pages;
+  for (const auto& contents : tabs) {
+    if (!contents) {
+      continue;
+    }
+    const int index =
+        browser->GetTabStripModel()->GetIndexOfWebContents(contents.get());
+    if (index == TabStripModel::kNoTab) {
+      continue;
+    }
+    pages.emplace_back(contents->GetVisibleURL(),
+                       browser->GetTabStripModel()->IsTabPinned(index));
+  }
+  if (pages.empty()) {
+    return;
+  }
+
+  SwitchToSpace(
+      browser, space,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> source,
+             std::vector<std::pair<GURL, bool>> pages,
+             std::vector<base::WeakPtr<content::WebContents>> tabs,
+             BrowserWindowInterface* target) {
+            for (size_t i = 0; i < pages.size(); ++i) {
+              NavigateParams params(target->GetProfile(), pages[i].first,
+                                    ui::PAGE_TRANSITION_LINK);
+              params.browser = target;
+              params.disposition =
+                  i + 1 == pages.size()
+                      ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                      : WindowOpenDisposition::NEW_BACKGROUND_TAB;
+              Navigate(&params);
+              if (pages[i].second && params.navigated_or_inserted_contents) {
+                TabStripModel* model = target->GetTabStripModel();
+                const int index = model->GetIndexOfWebContents(
+                    params.navigated_or_inserted_contents);
+                if (index != TabStripModel::kNoTab) {
+                  model->SetTabPinned(index, true);
+                }
+              }
+            }
+            if (!source) {
+              return;
+            }
+            TabStripModel* model = source->GetTabStripModel();
+            for (const auto& contents : tabs) {
+              const int index =
+                  contents ? model->GetIndexOfWebContents(contents.get())
+                           : TabStripModel::kNoTab;
+              if (index != TabStripModel::kNoTab) {
+                model->CloseWebContentsAt(
+                    index, TabCloseTypes::CLOSE_USER_GESTURE |
+                               TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+              }
+            }
+          },
+          browser->GetWeakPtr(), std::move(pages), tabs));
+}
+
+void ApplyDrop(base::WeakPtr<BrowserWindowInterface> browser,
+               std::vector<base::WeakPtr<content::WebContents>> tabs,
+               DropTarget target) {
+  if (!browser) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  auto index_of = [&](const base::WeakPtr<content::WebContents>& contents) {
+    return contents ? model->GetIndexOfWebContents(contents.get())
+                    : TabStripModel::kNoTab;
+  };
+
+  switch (target.action) {
+    case DropAction::kNone:
+      return;
+    case DropAction::kPin:
+      // Pinning moves each tab to the end of the pinned tabs, so going in
+      // order keeps them in order.
+      for (const auto& contents : tabs) {
+        const int index = index_of(contents);
+        if (index != TabStripModel::kNoTab && !model->IsTabPinned(index)) {
+          model->SetTabPinned(index, true);
+        }
+      }
+      return;
+    case DropAction::kUnpin:
+      // Unpinning moves each tab to the start of the other tabs, so going in
+      // reverse keeps them in order.
+      for (auto it = tabs.rbegin(); it != tabs.rend(); ++it) {
+        const int index = index_of(*it);
+        if (index != TabStripModel::kNoTab && model->IsTabPinned(index)) {
+          model->SetTabPinned(index, false);
+        }
+      }
+      return;
+    case DropAction::kMoveToSpace:
+      MoveToSpace(browser.get(), tabs, target.space);
+      return;
+  }
+}
