+// A soft rounded band showing where dropped tabs will go.
+class DropIndicator : public views::View {
+  METADATA_HEADER(DropIndicator, views::View)
+
+ public:
+  DropIndicator() {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetCanProcessEventsWithinSubtree(false);
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    // Solid, like the site pill, so the band reads clearly over the tabs.
+    SetBackground(views::CreateRoundedRectBackground(
+        kColorToolbarBackgroundSubtleEmphasis, kIndicatorCornerRadius));
+    SetBorder(views::CreateRoundedRectBorder(1, kIndicatorCornerRadius,
+                                             kColorToolbarButtonIconInactive));
+    SetUseDefaultFillLayout(true);
+    label_ = AddChildView(std::make_unique<views::Label>());
+    label_->SetEnabledColor(kColorToolbarButtonIcon);
+    label_->SetSubpixelRenderingEnabled(false);
+    label_->SetSkipSubpixelRenderingOpacityCheck(true);
+    label_->SetFontList(label_->font_list().DeriveWithSizeDelta(-1));
+    SetVisible(false);
+  }
+
+  // Shows the band over `bounds`, in its parent's coordinates, with `text`
+  // in it, or no text if the band covers tabs.
+  void ShowAt(const gfx::Rect& bounds, std::u16string_view text) {
+    // Called on every mouse move of a drag, so only change what changed.
+    if (label_->GetText() != text) {
+      label_->SetText(std::u16string(text));
+    }
+    if (this->bounds() != bounds) {
+      SetBoundsRect(bounds);
+    }
+    if (!GetVisible()) {
+      SetVisible(true);
+    }
+  }
+
+ private:
+  raw_ptr<views::Label> label_ = nullptr;
+};
