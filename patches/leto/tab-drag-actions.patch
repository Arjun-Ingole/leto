+void SpaceBarView::SetDropTarget(
+    const std::optional<base::FilePath>& profile_path) {
+  if (drop_target_ == profile_path) {
+    return;
+  }
+  drop_target_ = profile_path;
+  UpdateDropTarget();
+}
+
+void SpaceBarView::UpdateDropTarget() {
+  for (views::View* child : children()) {
+    auto* button = views::AsViewClass<SpaceButton>(child);
+    if (!button || button->is_current()) {
+      continue;
+    }
+    const bool targeted = drop_target_ == button->profile_path();
+    button->layer()->SetOpacity(targeted ? 1.0f : kInactiveOpacity);
+    // Grow the targeted space's button about its center.
+    gfx::Transform transform;
+    if (targeted) {
+      const gfx::PointF center(button->width() / 2.0f, button->height() / 2.0f);
+      transform.Translate(center.x(), center.y());
+      transform.Scale(kDropTargetScale, kDropTargetScale);
+      transform.Translate(-center.x(), -center.y());
+    }
+    button->layer()->SetTransform(transform);
+  }
+}
