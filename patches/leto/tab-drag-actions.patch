+std::optional<base::FilePath> SpaceBarView::GetOtherSpaceAt(
+    const gfx::Point& point_in_screen) const {
+  if (!GetVisible()) {
+    return std::nullopt;
+  }
+  for (const views::View* child : children()) {
+    const auto* button = views::AsViewClass<SpaceButton>(child);
+    if (!button || button->is_current()) {
+      continue;
+    }
+    // A little slack around the small buttons makes them easier to hit.
+    gfx::Rect bounds = button->GetBoundsInScreen();
+    bounds.Outset(kSpacing / 2);
+    if (bounds.Contains(point_in_screen)) {
+      return button->profile_path();
+    }
+  }
+  return std::nullopt;
+}
