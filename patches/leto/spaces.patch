+
+void SpaceBarView::Rebuild() {
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+
+  RemoveAllChildViews();
+
+  const base::FilePath& current_path =
+      browser_->GetProfile()->GetOriginalProfile()->GetPath();
+  const profiles::PlaceholderAvatarIconParams icon_params =
+      GetPlaceholderAvatarIconParamsVisibleAgainstColor(
+          color_provider->GetColor(kColorToolbar));
+  const int ring_inset = kRingThickness + kRingGap;
+  const int button_size = kIconSize + 2 * ring_inset;
+
+  for (ProfileAttributesEntry* entry :
+       GetStorage().GetAllProfilesAttributesSortedForDisplay()) {
+    if (entry->IsOmitted()) {
+      continue;
+    }
+
+    const base::FilePath profile_path = entry->GetPath();
+    auto button = std::make_unique<views::ImageButton>(base::BindRepeating(
+        [](base::WeakPtr<BrowserWindowInterface> browser,
+           const base::FilePath& path) {
+          if (browser) {
+            SwitchToSpace(browser.get(), path);
+          }
+        },
+        browser_->GetWeakPtr(), profile_path));
+
+    button->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromImage(profiles::GetSizedAvatarIcon(
+            entry->GetAvatarIcon(kIconSize, /*use_high_res_file=*/true,
+                                 icon_params),
+            kIconSize, kIconSize, profiles::SHAPE_CIRCLE)));
+    button->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+    button->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+    button->SetPreferredSize(gfx::Size(button_size, button_size));
+    button->SetTooltipText(entry->GetName());
+    button->GetViewAccessibility().SetName(entry->GetName());
+
+    button->SetPaintToLayer();
+    button->layer()->SetFillsBoundsOpaquely(false);
+    if (profile_path == current_path) {
+      button->SetBorder(views::CreateRoundedRectBorder(
+          kRingThickness, button_size / 2.0f, kColorToolbarButtonIcon));
+    } else {
+      button->layer()->SetOpacity(kInactiveOpacity);
+    }
+
+    AddChildView(std::move(button));
+  }
+
+  PreferredSizeChanged();
+}
