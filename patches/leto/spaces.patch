+namespace {
+
+// Moves `target` onto `bounds` and reveals it in place of `source`.
+void PresentInPlace(base::WeakPtr<BrowserWindowInterface> source,
+                    const gfx::Rect& bounds,
+                    BrowserWindowInterface* target) {
+  if (!target) {
+    return;
+  }
+  BrowserWindow* target_window = BrowserWindow::FromBrowser(target);
+  if (!target_window) {
+    return;
+  }
+
+  BrowserWindow* source_window = source && source.get() != target
+                                     ? BrowserWindow::FromBrowser(source.get())
+                                     : nullptr;
+  if (!source_window) {
+    target_window->SetBounds(bounds);
+    target_window->Show();
+    return;
+  }
+
+  internal::CrossfadeToWindow(
+      source_window, target_window, bounds,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> source) {
+            if (!source) {
+              return;
+            }
+            if (BrowserWindow* window =
+                    BrowserWindow::FromBrowser(source.get())) {
+              window->Hide();
+            }
+          },
+          source));
+}
+
+void OnTargetProfileLoaded(base::WeakPtr<BrowserWindowInterface> source,
+                           const gfx::Rect& bounds,
+                           Profile* profile) {
+  if (!profile) {
+    return;
+  }
+
+  // Hidden windows still count as being on the current workspace on macOS,
+  // so a space we switched away from earlier is found and reused here.
+  if (BrowserWindowInterface* existing =
+          ProfileBrowserCollection::GetForProfile(profile)
+              ->FindTabbedBrowser()) {
+    PresentInPlace(source, bounds, existing);
+    return;
+  }
+
+  profiles::OpenBrowserWindowForProfile(
+      base::BindOnce(&PresentInPlace, source, bounds),
+      /*always_create=*/false, /*is_new_profile=*/false,
+      /*open_command_line_urls=*/false, profile);
+}
+
+}  // namespace
+
+void SwitchSpace(BrowserWindowInterface* current, int delta) {
+  std::vector<base::FilePath> paths;
+  for (ProfileAttributesEntry* entry :
+       g_browser_process->profile_manager()
+           ->GetProfileAttributesStorage()
+           .GetAllProfilesAttributesSortedForDisplay()) {
+    if (!entry->IsOmitted()) {
+      paths.push_back(entry->GetPath());
+    }
+  }
+  if (paths.size() < 2) {
+    return;
+  }
+
+  auto it = std::ranges::find(paths, current->GetProfile()->GetPath());
+  if (it == paths.end()) {
+    return;
+  }
+  const int count = static_cast<int>(paths.size());
+  const int index = static_cast<int>(it - paths.begin());
+  SwitchToSpace(current, paths[((index + delta) % count + count) % count]);
+}
+
+void SwitchToSpace(BrowserWindowInterface* current,
+                   const base::FilePath& profile_path) {
+  Profile* profile = current->GetProfile();
+  if (profile->IsOffTheRecord() || profile->IsGuestSession() ||
+      profile->GetPath() == profile_path) {
+    return;
+  }
+
+  BrowserWindow* window = BrowserWindow::FromBrowser(current);
+  if (!window) {
+    return;
+  }
+
+  profiles::LoadProfileAsync(
+      profile_path, base::BindOnce(&OnTargetProfileLoaded,
+                                   current->GetWeakPtr(), window->GetBounds()));
+}
+
+}  // namespace leto
