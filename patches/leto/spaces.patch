+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/leto/space_switcher_mac.h"
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace leto::internal {
+
+namespace {
+
+constexpr NSTimeInterval kFadeDuration = 0.07;
+
+// How often to check whether the revealed window has drawn, and how many
+// checks to make before revealing it anyway (about 200ms).
+constexpr int64_t kFramePollIntervalNs = 8 * NSEC_PER_MSEC;
+constexpr int kMaxFramePolls = 25;
+
+void FadeOutAndHide(NSWindow* from, base::OnceClosure hide_from) {
+  __block base::OnceClosure done = std::move(hide_from);
+  [NSAnimationContext
+      runAnimationGroup:^(NSAnimationContext* context) {
+        context.duration = kFadeDuration;
+        context.timingFunction = [CAMediaTimingFunction
+            functionWithName:kCAMediaTimingFunctionEaseOut];
+        from.animator.alphaValue = 0.0;
+      }
+      completionHandler:^{
+        std::move(done).Run();
+        // The window is hidden now; restore its opacity so that it shows
+        // normally when its space is selected again.
+        from.alphaValue = 1.0;
+      }];
+}
+
+// Chromium keeps a re-shown window at zero alpha until its first compositor
+// frame arrives. Wait for that before fading, so that the desktop never shows
+// through between the two windows.
+void FadeOnceDrawn(NSWindow* from,
+                   NSWindow* to,
+                   base::OnceClosure hide_from,
+                   int polls_left) {
+  if (to.alphaValue > 0.0 || polls_left == 0) {
+    FadeOutAndHide(from, std::move(hide_from));
+    return;
+  }
+  __block base::OnceClosure pending = std::move(hide_from);
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, kFramePollIntervalNs),
+                 dispatch_get_main_queue(), ^{
+                   FadeOnceDrawn(from, to, std::move(pending), polls_left - 1);
+                 });
+}
+
+}  // namespace
+
+void CrossfadeToWindow(BrowserWindow* from,
+                       BrowserWindow* to,
+                       const gfx::Rect& bounds,
+                       base::OnceClosure hide_from) {
+  NSWindow* from_window = from->GetNativeWindow().GetNativeNSWindow();
+  NSWindow* to_window = to->GetNativeWindow().GetNativeNSWindow();
+
+  to->SetBounds(bounds);
+  to->Show();
+
+  // Full screen windows each live in their own macOS space, so there is
+  // nothing to fade between.
+  if (!from_window || !to_window || from->IsFullscreen() ||
+      to->IsFullscreen()) {
+    std::move(hide_from).Run();
+    return;
+  }
+
+  // Keep `to` focused but behind `from` until `from` has faded away.
+  [to_window orderWindow:NSWindowBelow relativeTo:from_window.windowNumber];
+  FadeOnceDrawn(from_window, to_window, std::move(hide_from), kMaxFramePolls);
+}
+
+}  // namespace leto::internal
