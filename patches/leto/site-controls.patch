+// A soft rounded highlight on hover, in the style of Helium's menus.
+void ConfigureHover(views::Button* button, int corner_radius) {
+  views::InkDrop::Get(button)->SetMode(views::InkDropHost::InkDropMode::ON);
+  button->SetHasInkDropActionOnClick(true);
+  views::InkDrop::Get(button)->SetBaseColor(ui::kColorSysOnSurface);
+  views::InkDrop::Get(button)->SetHighlightOpacity(0.06f);
+  views::InstallRoundRectHighlightPathGenerator(button, gfx::Insets(),
+                                                corner_radius);
+}
