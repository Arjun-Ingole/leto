+std::unique_ptr<views::Label> MakeSectionLabel(std::u16string_view text) {
+  auto label = std::make_unique<views::Label>(std::u16string(text));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+  label->SetFontList(
+      label->font_list().DeriveWithSizeDelta(-1).DeriveWithWeight(
+          gfx::Font::Weight::MEDIUM));
+  return label;
+}
