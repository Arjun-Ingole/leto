+
+// Owns an open popover; the delegate must outlive its widget.
+struct SiteControlsHost {
+  std::unique_ptr<views::BubbleDialogDelegate> delegate;
+  std::unique_ptr<views::Widget> widget;
+};
+
+}  // namespace
+
+void ShowSiteControls(BrowserWindowInterface* browser, views::View* anchor) {
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!contents || !anchor->GetWidget()) {
+    return;
+  }
+
+  auto host = std::make_unique<SiteControlsHost>();
+  host->delegate = std::make_unique<views::BubbleDialogDelegate>(
+      views::BubbleAnchor(anchor), views::BubbleBorder::LEFT_TOP);
+  views::BubbleDialogDelegate* delegate = host->delegate.get();
+  delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate->SetShowCloseButton(false);
+  delegate->set_margins(gfx::Insets(kPadding));
+  delegate->set_corner_radius(kCornerRadius);
+  delegate->set_fixed_width(kWidth);
+  delegate->SetContentsView(
+      std::make_unique<SiteControlsView>(browser, contents, anchor, delegate));
+
+  SiteControlsHost* raw_host = host.release();
+  raw_host->widget = views::BubbleDialogDelegate::CreateBubble(
+      delegate,
+      base::BindOnce(
+          [](SiteControlsHost* host, views::Widget::ClosedReason) {
+            host->widget->Hide();
+            base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+                FROM_HERE, host);
+          },
+          raw_host));
+  raw_host->widget->Show();
+}
+
+void SetExtensionPopupAnchor(BrowserWindowInterface* browser,
+                             views::View* anchor) {
+  if (anchor) {
+    PopupAnchors()[browser] = anchor;
+  } else {
+    PopupAnchors().erase(browser);
+  }
+}
+
+views::View* GetExtensionPopupAnchor(BrowserWindowInterface* browser) {
+  auto it = PopupAnchors().find(browser);
+  return it == PopupAnchors().end() ? nullptr : it->second;
+}
