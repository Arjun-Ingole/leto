+// An extension's action. Clicking runs it, as clicking its toolbar button
+// would; the context menu has the extension's options, pinning and removal.
+class ExtensionButton : public views::ImageButton,
+                        public views::ContextMenuController {
+  METADATA_HEADER(ExtensionButton, views::ImageButton)
+
+ public:
+  ExtensionButton(ToolbarActionViewModel* action,
+                  content::WebContents* contents,
+                  views::BubbleDialogDelegate* bubble,
+                  PressedCallback callback)
+      : views::ImageButton(std::move(callback)),
+        action_(action),
+        bubble_(bubble) {
+    SetImageModel(views::Button::STATE_NORMAL,
+                  action->GetIcon(contents, gfx::Size(kExtensionIconSize,
+                                                      kExtensionIconSize)));
+    SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+    SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+    SetPreferredSize(gfx::Size(kExtensionButtonSize, kExtensionButtonSize));
+    SetTooltipText(action->GetActionName());
+    GetViewAccessibility().SetName(action->GetActionName());
+    set_context_menu_controller(this);
+    ConfigureHover(this, kRowCornerRadius);
+  }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    ui::MenuModel* model = action_->GetContextMenu(
+        extensions::ExtensionContextMenuModel::ContextMenuSource::kMenuItem);
+    if (!model) {
+      return;
+    }
+    // Keep the popover open while its menu is.
+    close_pin_ = bubble_->PreventCloseOnDeactivate();
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        model, views::MenuRunner::CONTEXT_MENU,
+        base::BindRepeating(&ExtensionButton::OnMenuClosed,
+                            base::Unretained(this)));
+    menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                            views::MenuAnchorPosition::kTopLeft, source_type);
+  }
+
+ private:
+  void OnMenuClosed() { close_pin_.reset(); }
+
+  raw_ptr<ToolbarActionViewModel> action_;
+  raw_ptr<views::BubbleDialogDelegate> bubble_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  std::unique_ptr<views::BubbleDialogDelegate::CloseOnDeactivatePin> close_pin_;
+};
