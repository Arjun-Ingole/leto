+class SiteControlsView : public views::View {
+  METADATA_HEADER(SiteControlsView, views::View)
+
+ public:
+  SiteControlsView(BrowserWindowInterface* browser,
+                   content::WebContents* contents,
+                   views::View* anchor,
+                   views::BubbleDialogDelegate* bubble)
+      : browser_(browser), anchor_(anchor), bubble_(bubble) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(),
+        kSectionSpacing));
+
+    AddHeader(contents);
+    AddQuickActions();
+    AddExtensions(contents);
+    AddSiteRows(contents);
+  }
+
+ private:
+  void AddHeader(content::WebContents* contents) {
+    auto* header = AddChildView(std::make_unique<views::View>());
+    auto* layout = header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 4), 10));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    auto* favicon = header->AddChildView(std::make_unique<views::ImageView>());
+    favicon->SetImageSize(gfx::Size(16, 16));
+    if (auto* driver =
+            favicon::ContentFaviconDriver::FromWebContents(contents)) {
+      gfx::Image image = driver->GetFavicon();
+      if (!image.IsEmpty()) {
+        favicon->SetImage(ui::ImageModel::FromImage(image));
+      }
+    }
+
+    const GURL& url = contents->GetVisibleURL();
+    std::u16string title;
+    if (url.SchemeIsHTTPOrHTTPS()) {
+      std::string_view host = url.host();
+      if (base::StartsWith(host, "www.")) {
+        host.remove_prefix(4);
+      }
+      title = base::UTF8ToUTF16(host);
+    } else {
+      title = contents->GetTitle();
+    }
+    auto* label = header->AddChildView(std::make_unique<views::Label>(title));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetEnabledColor(ui::kColorSysOnSurface);
+    label->SetFontList(
+        label->font_list().DeriveWithSizeDelta(1).DeriveWithWeight(
+            gfx::Font::Weight::SEMIBOLD));
+    label->SetElideBehavior(gfx::ELIDE_HEAD);
+    layout->SetFlexForView(label, 1);
+  }
+
+  void AddQuickActions() {
+    auto* row = AddChildView(std::make_unique<views::View>());
+    auto* layout = row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 8));
+
+    auto add_tile = [&](const gfx::VectorIcon& icon, std::u16string_view text,
+                        int command) -> ActionTile* {
+      if (!chrome::IsCommandEnabled(browser_, command)) {
+        return nullptr;
+      }
+      auto* tile = row->AddChildView(std::make_unique<ActionTile>(
+          icon, text,
+          base::BindRepeating(&SiteControlsView::RunCommand,
+                              base::Unretained(this), command)));
+      layout->SetFlexForView(tile, 1);
+      return tile;
+    };
+
+    copy_tile_ = add_tile(vector_icons::kLinkIcon, kCopyLink, IDC_COPY_URL);
+    if (copy_tile_) {
+      copy_tile_->SetCallback(base::BindRepeating(&SiteControlsView::CopyLink,
+                                                  base::Unretained(this)));
+    }
+    add_tile(kMenuBookIcon, kReader, IDC_SHOW_READING_MODE_SIDE_PANEL);
+    add_tile(kQrCodeIcon, kQrCode, IDC_QRCODE_GENERATOR);
+    add_tile(kFindInPageIcon, kFind, IDC_FIND);
+    row->SetVisible(!row->children().empty());
+  }
+
+  void AddExtensions(content::WebContents* contents) {
+    auto* section = AddChildView(std::make_unique<views::View>());
+    section->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 6));
+
+    auto* title_row = section->AddChildView(std::make_unique<views::View>());
+    auto* title_layout =
+        title_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 4)));
+    title_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    title_layout->SetFlexForView(
+        title_row->AddChildView(MakeSectionLabel(kExtensions)), 1);
+    auto* manage = title_row->AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&SiteControlsView::RunCommand,
+                            base::Unretained(this), IDC_MANAGE_EXTENSIONS),
+        kManage));
+    manage->SetEnabledTextColors(ui::kColorSysOnSurfaceSubtle);
+    manage->SetLabelStyle(views::style::STYLE_BODY_5);
+    manage->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(2, 6)));
+    manage->SetMinSize(gfx::Size());
+    ConfigureHover(manage, 6);
+
+    ToolbarActionsModel* model =
+        ToolbarActionsModel::Get(browser_->GetProfile());
+    ExtensionsContainer* container = ExtensionsContainer::From(*browser_);
+    std::vector<std::string> ids;
+    if (model && container) {
+      // Pinned extensions first, as they would sit in the toolbar.
+      for (const auto& id : model->pinned_action_ids()) {
+        ids.push_back(id);
+      }
+      for (const auto& id : model->action_ids()) {
+        if (!std::ranges::contains(ids, id)) {
+          ids.push_back(id);
+        }
+      }
+    }
+
+    if (ids.empty()) {
+      auto* empty =
+          section->AddChildView(std::make_unique<views::Label>(kNoExtensions));
+      empty->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+      empty->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+      empty->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(4, 4)));
+      return;
+    }
+
+    views::View* grid_row = nullptr;
+    for (const auto& id : ids) {
+      ToolbarActionViewModel* action = container->GetActionForId(id);
+      if (!action) {
+        continue;
+      }
+      if (!grid_row || grid_row->children().size() == kExtensionsPerRow) {
+        grid_row = section->AddChildView(std::make_unique<views::View>());
+        grid_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 2));
+      }
+      grid_row->AddChildView(std::make_unique<ExtensionButton>(
+          action, contents, bubble_,
+          base::BindRepeating(&SiteControlsView::RunExtension,
+                              base::Unretained(this), id)));
+    }
+  }
+
+  void AddSiteRows(content::WebContents* contents) {
+    auto* rows = AddChildView(std::make_unique<views::View>());
+    rows->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+
+    const GURL& url = contents->GetVisibleURL();
+    if (url.SchemeIsHTTPOrHTTPS()) {
+      const bool secure = chrome_security_state::GetSecurityLevel(contents) ==
+                          security_state::SECURE;
+      rows->AddChildView(std::make_unique<ListRow>(
+          secure ? vector_icons::kLockIcon
+                 : vector_icons::kNotSecureWarningOldIcon,
+          secure ? ui::kColorSysOnSurface : ui::kColorSysError,
+          secure ? kSecure : kNotSecure, kChevronRightIcon,
+          base::BindRepeating(&SiteControlsView::OpenPageInfo,
+                              base::Unretained(this))));
+      rows->AddChildView(std::make_unique<ListRow>(
+          vector_icons::kSettingsIcon, ui::kColorSysOnSurface, kSiteSettings,
+          vector_icons::kOpenInNewFlippableIcon,
+          base::BindRepeating(&SiteControlsView::OpenSiteSettings,
+                              base::Unretained(this), url)));
+    }
+    rows->SetVisible(!rows->children().empty());
+  }
+
+  void Close() { bubble_->GetWidget()->Close(); }
+
+  void RunCommand(int command) {
+    Close();
+    chrome::ExecuteCommand(browser_, command);
+  }
+
+  void CopyLink() {
+    chrome::ExecuteCommand(browser_, IDC_COPY_URL);
+    copy_tile_->SetLabel(kCopied);
+  }
+
+  void RunExtension(const std::string& id) {
+    Close();
+    // The popup opens from the sidebar; see GetExtensionPopupAnchor().
+    if (ExtensionsContainer* container = ExtensionsContainer::From(*browser_)) {
+      if (ToolbarActionViewModel* action = container->GetActionForId(id)) {
+        action->ExecuteUserAction(
+            ToolbarActionViewModel::InvocationSource::kMenuEntry);
+      }
+    }
+  }
+
+  void OpenPageInfo() {
+    Close();
+    ShowPageInfo(browser_, anchor_);
+  }
+
+  void OpenSiteSettings(const GURL& url) {
+    Close();
+    chrome::ShowSiteSettings(browser_, url);
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::View> anchor_;
+  raw_ptr<views::BubbleDialogDelegate> bubble_;
+  raw_ptr<ActionTile> copy_tile_ = nullptr;
+};
