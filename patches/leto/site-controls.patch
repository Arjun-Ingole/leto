+// A quick action: an icon over a short label on a soft tile.
+class ActionTile : public views::Button {
+  METADATA_HEADER(ActionTile, views::Button)
+
+ public:
+  ActionTile(const gfx::VectorIcon& icon,
+             std::u16string_view text,
+             PressedCallback callback)
+      : views::Button(std::move(callback)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(8, 4), 4));
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    AddChildView(
+        std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+            icon, ui::kColorSysOnSurface, kTileIconSize)));
+    label_ = AddChildView(std::make_unique<views::Label>(std::u16string(text)));
+    label_->SetEnabledColor(ui::kColorSysOnSurfaceSubtle);
+    label_->SetFontList(label_->font_list().DeriveWithSizeDelta(-2));
+    SetBackground(views::CreateRoundedRectBackground(
+        ui::kColorSysStateHoverOnSubtle, kTileCornerRadius));
+    SetPreferredSize(gfx::Size(0, kTileHeight));
+    SetTooltipText(std::u16string(text));
+    GetViewAccessibility().SetName(std::u16string(text));
+    ConfigureHover(this, kTileCornerRadius);
+  }
+
+  void SetLabel(std::u16string_view text) {
+    label_->SetText(std::u16string(text));
+  }
+
+ private:
+  raw_ptr<views::Label> label_ = nullptr;
+};
