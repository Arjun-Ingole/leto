+bool CommandBarView::MoveTabIntoSplit(const AutocompleteMatch& match) {
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  tabs::TabInterface* pane = model->GetActiveTab();
+  if (!pane || !pane->IsSplit()) {
+    return false;
+  }
+  const GURL url = match.destination_url.GetWithoutRef();
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (tab->IsSplit() ||
+        tab->GetContents()->GetLastCommittedURL().GetWithoutRef() != url) {
+      continue;
+    }
+    // Hiding clears the results, which `match` may point into.
+    dismiss_.Run();
+    model->UpdateTabInSplit(pane, index,
+                            TabStripModel::SplitUpdateType::kReplace);
+    return true;
+  }
+  return false;
+}
