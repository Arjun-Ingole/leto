+// Adds an empty pane beside the active tab, in a new split view with it, and
+// activates the pane. A blank page rather than Chromium's tab picker, which
+// takes focus from the command bar as it loads.
+tabs::TabInterface* AddEmptySplitPane(BrowserWindowInterface* browser) {
+  TabStripModel* model = browser->GetTabStripModel();
+  const int active_index = model->active_index();
+  model->delegate()->AddTabAt(GURL(url::kAboutBlankURL), active_index + 1,
+                              /*foreground=*/true,
+                              model->GetTabGroupForTab(active_index),
+                              model->IsTabPinned(active_index));
+  model->AddToNewSplit(
+      {active_index},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  model->ActivateTabAt(active_index + 1);
+  return model->GetActiveTab();
+}
