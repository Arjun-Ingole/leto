+namespace {
+
+// Sites set to open in a space, as {site: profile directory name}.
+constexpr char kLinkRoutesPref[] = "leto.link_routes";
+
+constexpr int kMaxWidth = 1100;
+constexpr int kMaxHeight = 780;
+constexpr float kMaxScreenFraction = 0.72f;
+constexpr int kButtonSize = 28;
+constexpr int kButtonCornerRadius = 6;
+constexpr int kIconSize = 16;
+
+constexpr char16_t kOpenInLeto[] = u"Open in Leto";
+constexpr char16_t kMoreSpaces[] = u"Choose a space";
+
+// The site a link belongs to, for routing: its host without "www.".
+std::string SiteForUrl(const GURL& url) {
+  std::string_view host = url.host();
+  if (base::StartsWith(host, "www.")) {
+    host.remove_prefix(4);
+  }
+  return std::string(host);
+}
+
+// Spaces in the order the space bar shows them.
+std::vector<ProfileAttributesEntry*> GetSpaces() {
+  std::vector<ProfileAttributesEntry*> spaces;
+  for (ProfileAttributesEntry* entry :
+       g_browser_process->profile_manager()
+           ->GetProfileAttributesStorage()
+           .GetAllProfilesAttributesSortedForDisplay()) {
+    if (!entry->IsOmitted()) {
+      spaces.push_back(entry);
+    }
+  }
+  return spaces;
+}
+
+void SetSpaceForSite(const std::string& site,
+                     const base::FilePath& profile_path,
+                     bool always) {
+  ScopedDictPrefUpdate routes(g_browser_process->local_state(),
+                              kLinkRoutesPref);
+  if (always) {
+    routes->Set(site, profile_path.BaseName().AsUTF8Unsafe());
+  } else {
+    routes->Remove(site);
+  }
+}
+
+bool IsSiteInSpace(const std::string& site,
+                   const base::FilePath& profile_path) {
+  const std::string* name = g_browser_process->local_state()
+                                ->GetDict(kLinkRoutesPref)
+                                .FindString(site);
+  return name && *name == profile_path.BaseName().AsUTF8Unsafe();
+}
+
+// Shows `browser`'s space in place of the one on screen, or brings its window
+// forward if it is on screen already.
+void BringSpaceOnScreen(BrowserWindowInterface* browser) {
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser);
+  if (!window) {
+    return;
+  }
+  if (!window->IsVisible() && ShowSpace(browser)) {
+    return;
+  }
+  window->Show();
+  window->Activate();
+}
+
+// Moves the small window's page into the space of the profile at
+// `profile_path`, and closes the small window.
+void MoveToSpace(base::WeakPtr<BrowserWindowInterface> mini,
+                 const base::FilePath& profile_path) {
+  if (!mini) {
+    return;
+  }
+  content::WebContents* contents =
+      mini->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    return;
+  }
+  if (profile_path == mini->GetProfile()->GetPath()) {
+    // The page itself moves, keeping its state, as Chromium does for apps.
+    // The space comes on screen first, so that only its window is shown.
+    if (BrowserWindowInterface* target =
+            ProfileBrowserCollection::GetForProfile(mini->GetProfile())
+                ->FindTabbedBrowser()) {
+      BringSpaceOnScreen(target);
+    }
+    chrome::OpenInChrome(mini.get());
+    return;
+  }
+  // Pages can't move between profiles, so it opens afresh in the other space.
+  profiles::LoadProfileAsync(profile_path,
+                             base::BindOnce(
+                                 [](const GURL& url, Profile* profile) {
+                                   if (profile) {
+                                     OpenLinkInSpace(url, profile);
+                                   }
+                                 },
+                                 contents->GetVisibleURL()));
+  if (BrowserWindow* window = BrowserWindow::FromBrowser(mini.get())) {
+    window->Close();
+  }
+}
+
+std::unique_ptr<views::ImageButton> MakeButton(
+    const gfx::VectorIcon& icon,
+    std::u16string_view name,
+    views::Button::PressedCallback callback) {
+  auto button = std::make_unique<views::ImageButton>(std::move(callback));
+  button->SetImageModel(views::Button::STATE_NORMAL,
+                        ui::ImageModel::FromVectorIcon(
+                            icon, ui::kColorSysOnSurfaceSubtle, kIconSize));
+  button->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  button->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  button->SetPreferredSize(gfx::Size(kButtonSize, kButtonSize));
+  button->SetTooltipText(std::u16string(name));
+  button->GetViewAccessibility().SetName(std::u16string(name));
+  views::InkDrop::Get(button.get())
+      ->SetMode(views::InkDropHost::InkDropMode::ON);
+  button->SetHasInkDropActionOnClick(true);
+  views::InkDrop::Get(button.get())->SetBaseColor(ui::kColorSysOnSurface);
+  views::InkDrop::Get(button.get())->SetHighlightOpacity(0.08f);
+  views::InstallRoundRectHighlightPathGenerator(button.get(), gfx::Insets(),
+                                                kButtonCornerRadius);
+  return button;
+}
+
+// The small window's own buttons, at the end of its toolbar: one to move the
+// page into its space, and a menu to move it to another space or to always
+// open its site in one.
+class MiniWindowControls : public views::View,
+                           public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(MiniWindowControls, views::View)
+
+ public:
+  explicit MiniWindowControls(BrowserWindowInterface* mini)
+      : mini_(mini->GetWeakPtr()) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+                         views::BoxLayout::Orientation::kHorizontal,
+                         gfx::Insets::VH(0, 6), /*between_child_spacing=*/2))
+        ->set_cross_axis_alignment(
+            views::BoxLayout::CrossAxisAlignment::kCenter);
+    AddChildView(
+        MakeButton(kOpenInFullIcon, kOpenInLeto,
+                   base::BindRepeating(&MiniWindowControls::OpenInOwnSpace,
+                                       base::Unretained(this))));
+    spaces_button_ = AddChildView(
+        MakeButton(vector_icons::kKeyboardArrowDownIcon, kMoreSpaces,
+                   base::BindRepeating(&MiniWindowControls::ShowSpacesMenu,
+                                       base::Unretained(this))));
+  }
+  MiniWindowControls(const MiniWindowControls&) = delete;
+  MiniWindowControls& operator=(const MiniWindowControls&) = delete;
+  ~MiniWindowControls() override = default;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override {
+    const size_t index = static_cast<size_t>(command_id - kAlwaysCommand);
+    return command_id >= kAlwaysCommand && index < spaces_.size() &&
+           IsSiteInSpace(site_, spaces_[index]);
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id >= kAlwaysCommand) {
+      const size_t index = static_cast<size_t>(command_id - kAlwaysCommand);
+      if (index < spaces_.size()) {
+        SetSpaceForSite(site_, spaces_[index],
+                        !IsSiteInSpace(site_, spaces_[index]));
+      }
+      return;
+    }
+    const size_t index = static_cast<size_t>(command_id - kOpenCommand);
+    if (index < spaces_.size()) {
+      MoveToSpace(mini_, spaces_[index]);
+    }
+  }
+
+ private:
+  static constexpr int kOpenCommand = 1;
+  static constexpr int kAlwaysCommand = 1000;
+
+  void OpenInOwnSpace() {
+    if (mini_) {
+      MoveToSpace(mini_, mini_->GetProfile()->GetPath());
+    }
+  }
+
+  void ShowSpacesMenu() {
+    content::WebContents* contents =
+        mini_ ? mini_->GetTabStripModel()->GetActiveWebContents() : nullptr;
+    if (!contents || !GetWidget()) {
+      return;
+    }
+    site_ = SiteForUrl(contents->GetVisibleURL());
+    spaces_.clear();
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    const std::vector<ProfileAttributesEntry*> spaces = GetSpaces();
+    for (size_t i = 0; i < spaces.size(); ++i) {
+      spaces_.push_back(spaces[i]->GetPath());
+      menu_model_->AddItem(kOpenCommand + static_cast<int>(i),
+                           u"Open in " + spaces[i]->GetName());
+    }
+    if (!site_.empty()) {
+      menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+      for (size_t i = 0; i < spaces.size(); ++i) {
+        menu_model_->AddCheckItem(kAlwaysCommand + static_cast<int>(i),
+                                  u"Always open " + base::UTF8ToUTF16(site_) +
+                                      u" in " + spaces[i]->GetName());
+      }
+    }
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+    menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                            spaces_button_->GetAnchorBoundsInScreen(),
+                            views::MenuAnchorPosition::kTopRight,
+                            ui::mojom::MenuSourceType::kMouse);
+  }
+
+  base::WeakPtr<BrowserWindowInterface> mini_;
+  raw_ptr<views::ImageButton> spaces_button_ = nullptr;
+  // Set while the menu is built, for its commands.
+  std::string site_;
+  std::vector<base::FilePath> spaces_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+BEGIN_METADATA(MiniWindowControls)
+END_METADATA
+
+// Centred on the screen the pointer is on, smaller than the main window.
+gfx::Rect MiniWindowBounds() {
+  display::Screen* screen = display::Screen::Get();
+  const gfx::Rect work_area =
+      screen->GetDisplayNearestPoint(screen->GetCursorScreenPoint())
+          .work_area();
+  gfx::Rect bounds(
+      std::min(kMaxWidth,
+               static_cast<int>(work_area.width() * kMaxScreenFraction)),
+      std::min(kMaxHeight,
+               static_cast<int>(work_area.height() * kMaxScreenFraction)));
+  bounds.set_origin(work_area.CenterPoint() -
+                    gfx::Vector2d(bounds.width() / 2, bounds.height() / 2));
+  return bounds;
+}
+
+}  // namespace
+
+void RegisterMiniWindowLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kLinkRoutesPref);
+}
+
+std::optional<base::FilePath> GetSpaceForLink(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  const base::DictValue& routes =
+      g_browser_process->local_state()->GetDict(kLinkRoutesPref);
+  // A site's rule covers its subdomains too.
+  std::string_view site = url.host();
+  while (!site.empty()) {
+    std::string_view key = site;
+    if (base::StartsWith(key, "www.")) {
+      key.remove_prefix(4);
+    }
+    if (const std::string* name = routes.FindString(key)) {
+      const base::FilePath path =
+          g_browser_process->profile_manager()->user_data_dir().AppendASCII(
+              *name);
+      if (g_browser_process->profile_manager()
+              ->GetProfileAttributesStorage()
+              .GetProfileAttributesWithPath(path)) {
+        return path;
+      }
+    }
+    const size_t dot = site.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    site.remove_prefix(dot + 1);
+  }
+  return std::nullopt;
+}
+
+void OpenLinkInSpace(const GURL& url, Profile* profile) {
+  NavigateParams params(profile, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.browser =
+      ProfileBrowserCollection::GetForProfile(profile)->FindTabbedBrowser();
+  Navigate(&params);
+  if (params.browser) {
+    BringSpaceOnScreen(params.browser);
+  }
+}
+
+void OpenLinkInMiniWindow(const GURL& url, Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  NavigateParams params(profile, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_POPUP;
+  const gfx::Rect bounds = MiniWindowBounds();
+  params.window_features.bounds = bounds;
+  params.window_features.has_x = params.window_features.has_y = true;
+  params.window_features.has_width = params.window_features.has_height = true;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+
+  BrowserView* browser_view =
+      params.browser ? BrowserView::GetBrowserViewForBrowser(params.browser)
+                     : nullptr;
+  if (browser_view && browser_view->toolbar()) {
+    browser_view->toolbar()->AddChildView(
+        std::make_unique<MiniWindowControls>(params.browser));
+  }
+}
+
