+// Links opened from other apps, as in Arc's Little Arc: each opens in a small
+// window of its own instead of piling up as tabs in the main window. From
+// there the page can be moved into a space, and a site can be set to always
+// open in a particular space, like Arc's Air Traffic Control; those links skip
+// the small window and open as tabs in that space.
+
+void RegisterMiniWindowLocalStatePrefs(PrefRegistrySimple* registry);
+
+// The profile path of the space `url`'s site is set to open in, if any.
+std::optional<base::FilePath> GetSpaceForLink(const GURL& url);
+
+// Opens `url` as a tab in `profile`'s space and brings the space on screen.
+void OpenLinkInSpace(const GURL& url, Profile* profile);
+
+// Opens `url` in a small window of its own for `profile`.
+void OpenLinkInMiniWindow(const GURL& url, Profile* profile);
+
+}  // namespace leto
