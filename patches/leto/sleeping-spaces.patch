+#include "chrome/browser/ui/views/leto/sleeping_spaces.h"
+
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/performance_manager/policies/page_discarding_helper.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/leto/space_switcher.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "content/public/browser/web_contents.h"
+
+namespace leto {
+
+namespace {
+
+constexpr base::TimeDelta kCheckInterval = base::Minutes(5);
+// How long a tab in a space that isn't on screen stays awake after it was
+// last looked at.
+constexpr base::TimeDelta kSleepAfter = base::Minutes(15);
+
+bool IsSpaceHidden(BrowserWindowInterface* browser) {
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser);
+  return window && (!window->IsVisible() || window->IsMinimized());
+}
+
+void SleepTabs(BrowserWindowInterface* browser,
+               performance_manager::policies::PageDiscardingHelper* helper) {
+  // A space opened ahead of time is hidden until it's switched to, and its
+  // tabs were just restored, so it isn't left behind.
+  if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !IsSpaceHidden(browser) || IsPrewarmingSpace(browser)) {
+    return;
+  }
+  const base::Time cutoff = base::Time::Now() - kSleepAfter;
+  TabStripModel* model = browser->GetTabStripModel();
+  std::vector<const performance_manager::PageNode*> pages;
+  for (int index = 0; index < model->count(); ++index) {
+    content::WebContents* contents = model->GetWebContentsAt(index);
+    if (index == model->active_index() || contents->WasDiscarded() ||
+        contents->GetLastActiveTime() >= cutoff) {
+      continue;
+    }
+    if (base::WeakPtr<performance_manager::PageNode> page =
+            performance_manager::PerformanceManager::
+                GetPrimaryPageNodeForWebContents(contents)) {
+      pages.push_back(page.get());
+    }
+  }
+  if (!pages.empty()) {
+    helper->ImmediatelyDiscardMultiplePages(
+        pages, ::mojom::LifecycleUnitDiscardReason::PROACTIVE);
+  }
+}
+
+void SleepHiddenSpaces() {
+  auto* helper =
+      performance_manager::policies::PageDiscardingHelper::GetFromGraph(
+          performance_manager::PerformanceManager::GetGraph());
+  if (!helper) {
+    return;
+  }
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [helper](BrowserWindowInterface* browser) {
+        SleepTabs(browser, helper);
+        return true;
+      });
+}
+
+}  // namespace
+
+void StartSleepingSpaces() {
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  if (!timer->IsRunning()) {
+    timer->Start(FROM_HERE, kCheckInterval,
+                 base::BindRepeating(&SleepHiddenSpaces));
+  }
+}
+
+}  // namespace leto
