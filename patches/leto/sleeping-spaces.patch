+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_LETO_SLEEPING_SPACES_H_
+#define CHROME_BROWSER_UI_VIEWS_LETO_SLEEPING_SPACES_H_
+
+namespace leto {
+
+// Puts tabs in spaces that aren't on screen to sleep, as Edge and Brave do for
+// background tabs, to free the memory they hold. A tab sleeps once it hasn't
+// been looked at for a while; each space's active tab stays awake so switching
+// back is instant. Chromium's own rules for discarding decide which tabs are
+// safe to put to sleep, so tabs playing media or holding unsaved form input
+// are left alone.
+
+// Starts checking the spaces periodically. Safe to call more than once.
+void StartSleepingSpaces();
+
+}  // namespace leto
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LETO_SLEEPING_SPACES_H_
