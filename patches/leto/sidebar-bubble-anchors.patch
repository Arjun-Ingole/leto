+// Leto: the toolbar stays hidden, and anchoring to it would bring it back, so
+// bubbles about the page open from the sidebar's site pill instead, revealing
+// the sidebar if it is hidden.
+std::optional<AnchorConfiguration> GetSidebarAnchorConfiguration(
+    BrowserWindowInterface* browser) {
+  if (!browser || !leto::UsesCommandBar(browser)) {
+    return std::nullopt;
+  }
+  views::View* pill = leto::GetExtensionPopupAnchor(browser);
+  if (!pill || !pill->GetWidget()) {
+    return std::nullopt;
+  }
+  if (BrowserView* browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser)) {
+    browser_view->RevealSidebarForBubble();
+  }
+  if (!pill->IsDrawn()) {
+    return std::nullopt;
+  }
+  return AnchorConfiguration{views::BubbleAnchor(pill), std::nullopt,
+                             views::BubbleBorder::LEFT_TOP};
+}
+
+}  // namespace
+#endif
