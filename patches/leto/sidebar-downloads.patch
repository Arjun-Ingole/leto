+bool BrowserView::HasOpenBubbleFromSidebarControls() const {
+  if (!vertical_tab_strip_region_view_ || !GetWidget()) {
+    return false;
+  }
+  // The footer, and the header around the site pill. Bubbles from the tabs in
+  // between, like hover cards, come and go with the cursor instead.
+  std::vector<const views::View*> roots;
+  if (const views::View* footer =
+          vertical_tab_strip_region_view_->GetBottomContainer()) {
+    roots.push_back(footer);
+  }
+  if (const views::View* pill = leto::GetExtensionPopupAnchor(browser_);
+      pill && pill->parent()) {
+    roots.push_back(pill->parent());
+  }
+  for (views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(GetWidget()->GetNativeView())) {
+    for (const views::View* root : roots) {
+      if (IsOpenBubbleAnchoredInViewSubtree(widget, root)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+ToolbarButton* BrowserView::GetSidebarDownloadsButton() {
+  if (!vertical_tab_strip_region_view_ || !ShouldDrawVerticalTabStrip() ||
+      !vertical_tab_strip_region_view_->GetBottomContainer()) {
+    return nullptr;
+  }
+  return vertical_tab_strip_region_view_->GetBottomContainer()
+      ->downloads_button();
+}
+
+void BrowserView::RevealSidebarForBubble() {
+  if (!zen_mode_enabled_ || zen_side_chrome_animation_.GetCurrentValue() == 1) {
+    return;
+  }
+  zen_cursor_exit_timer_.Stop();
+  zen_side_chrome_animation_.Reset(1);
+  if (auto* frame_view = GetFrameView()) {
+    frame_view->SetCaptionButtonsOpacity(1.0f);
+  }
+  InvalidateLayout();
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::OnSidebarBubbleClosed() {
+  if (!zen_mode_enabled_) {
+    return;
+  }
+  // The bubble's widget is still closing, so check once it is gone.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrowserView::UpdateZenModeRevealFromCursor,
+                                GetAsWeakPtr()));
+}
