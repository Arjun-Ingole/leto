+// A row in the results list: icon, title, a dimmed URL or description, and
+// "Switch to Tab" for open tabs.
+class CommandBarResultView : public views::Button {
+  METADATA_HEADER(CommandBarResultView, views::Button)
+
+ public:
+  CommandBarResultView(CommandBarView* command_bar, size_t index)
+      : views::Button(base::BindRepeating(&CommandBarView::OpenResult,
+                                          base::Unretained(command_bar),
+                                          index)),
+        command_bar_(command_bar),
+        index_(index) {
+    auto* layout = SetLayoutManager(std::make_unique<views::FlexLayout>());
+    layout->SetOrientation(views::LayoutOrientation::kHorizontal)
+        .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+        .SetInteriorMargin(gfx::Insets::VH(0, kRowPadding))
+        .SetMinimumCrossAxisSize(kRowHeight);
+
+    icon_ = AddChildView(std::make_unique<views::ImageView>());
+    icon_->SetImageSize(gfx::Size(kRowIconSize, kRowIconSize));
+    icon_->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 0, 0, 10));
+
+    title_ = AddChildView(std::make_unique<views::Label>());
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetEnabledColor(kColorOmniboxText);
+    title_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kPreferred)
+            .WithOrder(2));
+
+    detail_ = AddChildView(std::make_unique<views::Label>());
+    detail_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    detail_->SetEnabledColor(kColorOmniboxResultsTextDimmed);
+    detail_->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 6, 0, 0));
+    detail_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kPreferred)
+            .WithOrder(1));
+
+    auto* spacer = AddChildView(std::make_unique<views::View>());
+    spacer->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded)
+            .WithOrder(3));
+
+    chip_ = AddChildView(std::make_unique<views::Label>(kSwitchToTab));
+    chip_->SetEnabledColor(kColorOmniboxResultsTextDimmed);
+    chip_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(2, 6)));
+    chip_->SetBackground(views::CreateRoundedRectBackground(
+        kColorOmniboxResultsChipBackground, 4));
+    chip_->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 12, 0, 0));
+    chip_->SetFontList(chip_->font_list().DeriveWithSizeDelta(-1));
+
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListBoxOption);
+  }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(
+        views::Button::CalculatePreferredSize(available_size).width(),
+        kRowHeight);
+  }
+
+  void SetMatch(const AutocompleteMatch& match, FaviconCache& favicon_cache) {
+    weak_factory_.InvalidateWeakPtrs();
+
+    std::u16string title = match.contents;
+    std::u16string detail = match.description;
+    if (!AutocompleteMatch::IsSearchType(match.type) &&
+        !match.description.empty()) {
+      // Pages read best as their title, with the address after it.
+      title = match.description;
+      detail = match.contents;
+    }
+    title_->SetText(title);
+    detail_->SetText(detail.empty() ? detail : u"\u2013 " + detail);
+    detail_->SetVisible(!detail.empty());
+    chip_->SetVisible(IsTabMatch(match));
+    GetViewAccessibility().SetName(title + u" " + detail);
+
+    icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        match.GetVectorIcon(/*is_bookmark=*/false), kColorOmniboxResultsIcon,
+        kRowIconSize));
+    if (!AutocompleteMatch::IsSearchType(match.type) &&
+        match.destination_url.is_valid()) {
+      gfx::Image favicon = favicon_cache.GetFaviconForPageUrl(
+          match.destination_url,
+          base::BindOnce(&CommandBarResultView::SetFavicon,
+                         weak_factory_.GetWeakPtr()));
+      if (!favicon.IsEmpty()) {
+        SetFavicon(favicon);
+      }
+    }
+  }
+
+  void SetSelected(bool selected) {
+    if (selected == selected_) {
+      return;
+    }
+    selected_ = selected;
+    SetBackground(
+        selected ? views::CreateRoundedRectBackground(
+                       kColorOmniboxResultsBackgroundSelected, kRowCornerRadius)
+                 : nullptr);
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    views::Button::OnMouseEntered(event);
+    command_bar_->SelectResult(index_);
+  }
+
+ private:
+  void SetFavicon(const gfx::Image& favicon) {
+    icon_->SetImage(ui::ImageModel::FromImage(favicon));
+  }
+
+  raw_ptr<CommandBarView> command_bar_;
+  const size_t index_;
+  bool selected_ = false;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> detail_ = nullptr;
+  raw_ptr<views::Label> chip_ = nullptr;
+  base::WeakPtrFactory<CommandBarResultView> weak_factory_{this};
+};
