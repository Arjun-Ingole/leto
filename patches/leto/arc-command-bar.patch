+// A browser window's command bar, created on first use and then hidden rather
+// than closed so it opens quickly and keeps its autocomplete state warm.
+class CommandBarHost : public views::WidgetObserver {
+ public:
+  explicit CommandBarHost(BrowserView* browser_view);
+  CommandBarHost(const CommandBarHost&) = delete;
+  CommandBarHost& operator=(const CommandBarHost&) = delete;
+  ~CommandBarHost() override;
+
+  static CommandBarHost* ForBrowserView(BrowserView* browser_view);
+
+  void Show(CommandBarMode mode);
+  // Hides the bar; with `refocus_page`, moves focus back to the page.
+  void Hide(bool refocus_page);
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  static std::map<BrowserView*, CommandBarHost*>& Hosts();
+
+  void InterceptClose();
+  void OnCloseRequested(views::Widget::ClosedReason reason);
+  void UpdateBounds();
+
+  raw_ptr<BrowserView> browser_view_;
+  // Must outlive `widget_`.
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  raw_ptr<CommandBarView> view_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+  base::WeakPtrFactory<CommandBarHost> weak_factory_{this};
+};
+
+CommandBarHost::CommandBarHost(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  Hosts()[browser_view] = this;
+
+  // The bubble hangs from the anchor point and grows downwards as results
+  // come in; the view resizes it.
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      views::BubbleAnchor(), views::BubbleBorder::TOP_CENTER,
+      views::BubbleBorder::STANDARD_SHADOW);
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetShowCloseButton(false);
+  delegate_->set_margins(gfx::Insets());
+  delegate_->set_corner_radius(kCornerRadius);
+  delegate_->SetBackgroundColor(kColorOmniboxResultsBackground);
+  delegate_->set_parent_window(browser_view->GetWidget()->GetNativeView());
+  view_ = delegate_->SetContentsView(std::make_unique<CommandBarView>(
+      browser_view,
+      base::BindRepeating(&CommandBarHost::Hide, base::Unretained(this),
+                          /*refocus_page=*/true)));
+  UpdateBounds();
+
+  widget_ = views::BubbleDialogDelegate::CreateBubble(delegate_.get());
+  observation_.Observe(widget_.get());
+  InterceptClose();
+}
+
+CommandBarHost::~CommandBarHost() {
+  Hosts().erase(browser_view_);
+}
+
+// static
+std::map<BrowserView*, CommandBarHost*>& CommandBarHost::Hosts() {
+  static base::NoDestructor<std::map<BrowserView*, CommandBarHost*>> hosts;
+  return *hosts;
+}
+
+// static
+CommandBarHost* CommandBarHost::ForBrowserView(BrowserView* browser_view) {
+  auto it = Hosts().find(browser_view);
+  return it == Hosts().end() ? nullptr : it->second;
+}
+
+void CommandBarHost::Show(CommandBarMode mode) {
+  UpdateBounds();
+  widget_->Show();
+  view_->Start(mode);
+}
+
+void CommandBarHost::Hide(bool refocus_page) {
+  if (!widget_->IsVisible()) {
+    return;
+  }
+  widget_->Hide();
+  view_->Stop();
+  if (!refocus_page) {
+    return;
+  }
+  browser_view_->GetWidget()->Activate();
+  if (content::WebContents* contents = browser_view_->GetActiveWebContents()) {
+    contents->Focus();
+  }
+}
+
+void CommandBarHost::OnWidgetDestroying(views::Widget* widget) {
+  // The browser window is closing and took the bar's window with it.
+  observation_.Reset();
+  view_ = nullptr;
+  Hosts().erase(browser_view_);
+  base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+}
+
+void CommandBarHost::InterceptClose() {
+  // Requests to close the bubble (Escape, clicking elsewhere) hide it instead.
+  // The override is consumed by each request, so it is set again each time.
+  widget_->MakeCloseSynchronous(base::BindOnce(
+      &CommandBarHost::OnCloseRequested, weak_factory_.GetWeakPtr()));
+}
+
+void CommandBarHost::OnCloseRequested(views::Widget::ClosedReason reason) {
+  InterceptClose();
+  Hide(/*refocus_page=*/reason != views::Widget::ClosedReason::kLostFocus);
+}
+
+void CommandBarHost::UpdateBounds() {
+  const gfx::Rect window_bounds = browser_view_->GetBoundsInScreen();
+  const int width = std::min(
+      kMaxWidth, static_cast<int>(window_bounds.width() * kWidthFraction));
+  delegate_->set_fixed_width(width);
+  if (views::Widget* widget = delegate_->GetWidget()) {
+    widget->client_view()->InvalidateLayout();
+  }
+  delegate_->SetAnchorRect(
+      gfx::Rect(window_bounds.CenterPoint().x() - width / 2,
+                window_bounds.y() +
+                    static_cast<int>(window_bounds.height() * kTopFraction),
+                width, 0));
+}
+
+}  // namespace
+
+bool UsesCommandBar(BrowserWindowInterface* browser) {
+#if BUILDFLAG(IS_MAC)
+  if (browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  const PrefService* prefs = browser->GetProfile()->GetPrefs();
+  return prefs->GetBoolean(prefs::kHeliumZenMode) &&
+         !prefs->GetBoolean(prefs::kHeliumZenModeTopChromePinned);
+#else
+  return false;
+#endif
+}
+
+void ShowCommandBar(BrowserWindowInterface* browser, CommandBarMode mode) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !browser_view->GetWidget()) {
+    return;
+  }
+  CommandBarHost* host = CommandBarHost::ForBrowserView(browser_view);
+  if (!host) {
+    host = new CommandBarHost(browser_view);
+  }
+  host->Show(mode);
+}
