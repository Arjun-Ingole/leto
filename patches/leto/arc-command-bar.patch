+CommandBarView::CommandBarView(BrowserView* browser_view,
+                               base::RepeatingClosure dismiss)
+    : browser_view_(browser_view),
+      dismiss_(std::move(dismiss)),
+      favicon_cache_(FaviconServiceFactory::GetForProfile(
+                         browser_view->browser()->GetProfile(),
+                         ServiceAccessType::EXPLICIT_ACCESS),
+                     HistoryServiceFactory::GetForProfile(
+                         browser_view->browser()->GetProfile(),
+                         ServiceAccessType::EXPLICIT_ACCESS)) {
+  Profile* profile = browser_view->browser()->GetProfile();
+  autocomplete_controller_ = std::make_unique<AutocompleteController>(
+      std::make_unique<ChromeAutocompleteProviderClient>(profile),
+      AutocompleteControllerConfig{
+          .provider_types = AutocompleteClassifier::DefaultOmniboxProviders(),
+          // List open tabs alongside history and suggestions.
+          .unscoped_open_tab_suggestions = true,
+          .show_iph_matches = false,
+      });
+  autocomplete_controller_->AddObserver(this);
+
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  auto* input_row = AddChildView(std::make_unique<views::View>());
+  auto* input_layout =
+      input_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal,
+          gfx::Insets::VH(0, kInputPadding), 12));
+  input_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  input_layout->set_minimum_cross_axis_size(kInputHeight);
+  input_row->AddChildView(
+      std::make_unique<views::ImageView>(ui::ImageModel::FromVectorIcon(
+          vector_icons::kSearchIcon, kColorOmniboxResultsIcon,
+          kInputIconSize)));
+
+  textfield_ = input_row->AddChildView(std::make_unique<views::Textfield>());
+  textfield_->set_controller(this);
+  textfield_->SetBorder(views::NullBorder());
+  textfield_->SetBackgroundEnabled(false);
+  textfield_->SetFontList(
+      gfx::FontList().DeriveWithSizeDelta(kInputFontSizeDelta));
+  textfield_->SetTextColorId(kColorOmniboxText);
+  textfield_->SetPlaceholderText(kPlaceholder);
+  textfield_->SetPlaceholderTextColorId(kColorOmniboxTextDimmed);
+  textfield_->GetViewAccessibility().SetName(kPlaceholder);
+  input_layout->SetFlexForView(textfield_, 1);
+
+  results_ = AddChildView(std::make_unique<views::View>());
+  results_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::TLBR(0, kResultsPadding, kResultsPadding, kResultsPadding)));
+  results_->SetVisible(false);
+}
+
+CommandBarView::~CommandBarView() {
+  autocomplete_controller_->RemoveObserver(this);
+}
+
+void CommandBarView::Start(CommandBarMode mode) {
+  mode_ = mode;
+  Stop();
+
+  // Cmd+L edits the current address; Cmd+T starts from an empty field.
+  std::u16string text;
+  content::WebContents* contents = browser_view_->GetActiveWebContents();
+  if (mode_ == CommandBarMode::kCurrentTab && contents) {
+    const GURL& url = contents->GetVisibleURL();
+    if (!url.is_empty() && url.host() != chrome::kChromeUINewTabHost) {
+      text = base::UTF8ToUTF16(url.spec());
+    }
+  }
+  user_text_ = text;
+  textfield_->SetText(text);
+  textfield_->SelectAll(/*reversed=*/false);
+  textfield_->RequestFocus();
+}
+
+void CommandBarView::Stop() {
+  autocomplete_controller_->Stop(AutocompleteStopReason::kClobbered);
+  selected_index_.reset();
+  UpdateResults();
+}
+
+void CommandBarView::SelectResult(size_t index) {
+  if (index >= result_views_.size() || selected_index_ == index) {
+    return;
+  }
+  if (selected_index_ && *selected_index_ < result_views_.size()) {
+    result_views_[*selected_index_]->SetSelected(false);
+  }
+  selected_index_ = index;
+  result_views_[index]->SetSelected(true);
+}
+
+void CommandBarView::OpenResult(size_t index) {
+  const AutocompleteResult& result = autocomplete_controller_->result();
+  if (index < result.size()) {
+    OpenMatch(result.match_at(index));
+  }
+}
+
+void CommandBarView::AddedToWidget() {
+  // Escape dismisses the bar at once, even while there is text to clear.
+  GetFocusManager()->RegisterAccelerator(
+      ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE),
+      ui::AcceleratorManager::kHighPriority, this);
+}
+
+void CommandBarView::RemovedFromWidget() {
+  if (views::FocusManager* focus_manager = GetFocusManager()) {
+    focus_manager->UnregisterAccelerators(this);
+  }
+}
+
+bool CommandBarView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  dismiss_.Run();
+  return true;
+}
+
+bool CommandBarView::CanHandleAccelerators() const {
+  return GetWidget() && GetWidget()->IsVisible();
+}
+
+void CommandBarView::ContentsChanged(views::Textfield* sender,
+                                     const std::u16string& new_contents) {
+  // Deleting text, including a suggested completion, should not bring the
+  // completion straight back.
+  const bool deleting = new_contents.size() <= user_text_.size();
+  user_text_ = new_contents;
+  StartQuery(/*prevent_inline_autocomplete=*/deleting);
+}
+
+bool CommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                    const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  switch (key_event.key_code()) {
+    case ui::VKEY_DOWN:
+    case ui::VKEY_UP: {
+      if (result_views_.empty()) {
+        return true;
+      }
+      const size_t count = result_views_.size();
+      const size_t current = selected_index_.value_or(0);
+      SelectResult(key_event.key_code() == ui::VKEY_DOWN
+                       ? (current + 1) % count
+                       : (current + count - 1) % count);
+      return true;
+    }
+    case ui::VKEY_RETURN: {
+      if (selected_index_) {
+        OpenResult(*selected_index_);
+        return true;
+      }
+      // Nothing listed yet: open what was typed.
+      if (textfield_->GetText().empty()) {
+        return true;
+      }
+      AutocompleteMatch match;
+      AutocompleteClassifierFactory::GetForProfile(
+          browser_view_->browser()->GetProfile())
+          ->Classify(std::u16string(textfield_->GetText()), false, false,
+                     metrics::OmniboxEventProto::OTHER, &match, nullptr);
+      if (match.destination_url.is_valid()) {
+        OpenMatch(match);
+      }
+      return true;
+    }
+    default:
+      return false;
+  }
+}
+
+void CommandBarView::OnResultChanged(AutocompleteController* controller,
+                                     bool default_match_changed) {
+  const AutocompleteMatch* default_match = controller->result().default_match();
+  if (default_match && !default_match->inline_autocompletion.empty() &&
+      !controller->input().prevent_inline_autocomplete() &&
+      controller->input().text() == user_text_ &&
+      textfield_->GetText() == user_text_) {
+    // Complete the address inline, selected so typing replaces it.
+    textfield_->SetText(user_text_ + default_match->inline_autocompletion);
+    textfield_->SetSelectedRange(
+        gfx::Range(user_text_.size(), textfield_->GetText().size()));
+  }
+  UpdateResults();
+}
+
+void CommandBarView::StartQuery(bool prevent_inline_autocomplete) {
+  if (user_text_.empty()) {
+    autocomplete_controller_->Stop(AutocompleteStopReason::kClobbered);
+    UpdateResults();
+    return;
+  }
+  Profile* profile = browser_view_->browser()->GetProfile();
+  AutocompleteInput input(user_text_, metrics::OmniboxEventProto::OTHER,
+                          ChromeAutocompleteSchemeClassifier(profile));
+  if (content::WebContents* contents = browser_view_->GetActiveWebContents()) {
+    input.set_current_url(contents->GetVisibleURL());
+  }
+  input.set_prevent_inline_autocomplete(prevent_inline_autocomplete);
+  autocomplete_controller_->Start(input);
+}
+
+void CommandBarView::UpdateResults() {
+  const AutocompleteResult& result = autocomplete_controller_->result();
+  const size_t count =
+      user_text_.empty() ? 0 : std::min(result.size(), kMaxResults);
+
+  if (result_views_.size() != count) {
+    results_->RemoveAllChildViews();
+    result_views_.clear();
+    for (size_t i = 0; i < count; ++i) {
+      result_views_.push_back(results_->AddChildView(
+          std::make_unique<CommandBarResultView>(this, i)));
+    }
+  }
+  for (size_t i = 0; i < count; ++i) {
+    result_views_[i]->SetMatch(result.match_at(i), favicon_cache_);
+    result_views_[i]->SetSelected(false);
+  }
+  selected_index_.reset();
+  if (count > 0) {
+    // The first result is what Enter opens.
+    SelectResult(0);
+  }
+
+  results_->SetVisible(count > 0);
+  PreferredSizeChanged();
+  // Fit the bubble to the list as it grows and shrinks.
+  if (views::Widget* widget = GetWidget()) {
+    if (auto* bubble = widget->widget_delegate()->AsBubbleDialogDelegate()) {
+      bubble->SizeToContents();
+    }
+  }
+}
+
+void CommandBarView::OpenMatch(const AutocompleteMatch& match) {
+  BrowserWindowInterface* browser = browser_view_->browser();
+  WindowOpenDisposition disposition =
+      mode_ == CommandBarMode::kNewTab
+          ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+          : WindowOpenDisposition::CURRENT_TAB;
+  if (IsTabMatch(match)) {
+    disposition = WindowOpenDisposition::SWITCH_TO_TAB;
+  }
+  NavigateParams params(
+      browser, match.destination_url,
+      ui::PageTransitionFromInt(match.transition |
+                                ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+  params.disposition = disposition;
+
+  // Hiding clears the results, which `match` may point into.
+  dismiss_.Run();
+  Navigate(&params);
+}
