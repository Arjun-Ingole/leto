+namespace leto {
+
+// Arc style command bar: the address bar in a panel floating over the page,
+// used in place of the toolbar's address bar when the toolbar is hidden.
+
+enum class CommandBarMode {
+  // Opened with Cmd+L or the site pill: results open in the current tab.
+  kCurrentTab,
+  // Opened with Cmd+T: results open in a new tab.
+  kNewTab,
+};
+
+// True when the toolbar is hidden and the sidebar holds navigation, which is
+// when the command bar replaces the toolbar's address bar.
+bool UsesCommandBar(BrowserWindowInterface* browser);
+
+void ShowCommandBar(BrowserWindowInterface* browser, CommandBarMode mode);
+
