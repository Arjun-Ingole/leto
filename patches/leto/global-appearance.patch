+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/leto/global_appearance.h"
+
+#include <array>
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace leto {
+
+namespace {
+
+constexpr char kGlobalAppearancePref[] = "leto.global_appearance";
+
+// Profile prefs that shape how a browser window looks. Names are listed
+// literally so that a pref which is missing on some build is simply skipped.
+constexpr auto kSharedPrefs = std::to_array<const char*>({
+    // Helium layout and window chrome.
+    "helium.browser.layout",
+    "helium.browser.zen_mode",
+    "helium.browser.zen_mode_sidebar_pinned",
+    "helium.browser.zen_mode_top_chrome_pinned",
+    "helium.browser.rounded_frame",
+    "helium.browser.native_frame_materials",
+    "helium.browser.vertical_right_aligned",
+    "helium.browser.centered_location_bar",
+    "helium.browser.minimal_location_bar",
+    "helium.browser.show_progress_bar",
+    // Toolbar buttons.
+    "browser.show_home_button",
+    "browser.show_forward_button",
+    "browser.pin_split_tab_button",
+    // Sidebar and side panel.
+    "side_panel.is_right_aligned",
+    "vertical_tabs.expand_on_hover",
+    "vertical_tabs.collapsed_state",
+    "vertical_tabs.uncollapsed_width",
+    // Theme colors.
+    "browser.theme.color_scheme2",
+    "browser.theme.user_color2",
+    "browser.theme.color_variant2",
+    "browser.theme.follows_system_colors",
+    "browser.theme.is_grayscale2",
+    // Font sizes.
+    "webkit.webprefs.default_font_size",
+    "webkit.webprefs.default_fixed_font_size",
+    "webkit.webprefs.minimum_font_size",
+});
+
+class GlobalAppearance : public ProfileObserver {
+ public:
+  static GlobalAppearance& Get() {
+    static base::NoDestructor<GlobalAppearance> instance;
+    return *instance;
+  }
+
+  void Attach(Profile* profile) {
+    if (profile->IsOffTheRecord() || registrars_.contains(profile)) {
+      return;
+    }
+
+    PrefService* local_state = g_browser_process->local_state();
+    PrefService* prefs = profile->GetPrefs();
+    const base::DictValue stored =
+        local_state->GetDict(kGlobalAppearancePref).Clone();
+
+    {
+      base::AutoReset<bool> propagating(&propagating_, true);
+      ScopedDictPrefUpdate update(local_state, kGlobalAppearancePref);
+      for (const char* name : kSharedPrefs) {
+        const PrefService::Preference* pref = prefs->FindPreference(name);
+        if (!pref) {
+          continue;
+        }
+        if (const base::Value* value = stored.Find(name)) {
+          prefs->Set(name, *value);
+        } else if (!pref->IsDefaultValue()) {
+          // The first profile that carries this setting defines it for all.
+          update->Set(name, pref->GetValue()->Clone());
+        }
+      }
+    }
+
+    auto registrar = std::make_unique<PrefChangeRegistrar>();
+    registrar->Init(prefs);
+    for (const char* name : kSharedPrefs) {
+      if (prefs->FindPreference(name)) {
+        registrar->Add(name,
+                       base::BindRepeating(&GlobalAppearance::OnPrefChanged,
+                                           base::Unretained(this), profile,
+                                           std::string(name)));
+      }
+    }
+    registrars_[profile] = std::move(registrar);
+    profile_observations_.AddObservation(profile);
+  }
+
+ private:
+  friend class base::NoDestructor<GlobalAppearance>;
+
+  GlobalAppearance() = default;
+  ~GlobalAppearance() override = default;
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    registrars_.erase(profile);
+    profile_observations_.RemoveObservation(profile);
+  }
+
+  void OnPrefChanged(Profile* source, const std::string& name) {
+    if (propagating_) {
+      return;
+    }
+    base::AutoReset<bool> propagating(&propagating_, true);
+
+    const base::Value& value = source->GetPrefs()->GetValue(name);
+    ScopedDictPrefUpdate(g_browser_process->local_state(),
+                         kGlobalAppearancePref)
+        ->Set(name, value.Clone());
+    for (const auto& [profile, registrar] : registrars_) {
+      if (profile != source) {
+        profile->GetPrefs()->Set(name, value);
+      }
+    }
+  }
+
+  std::map<Profile*, std::unique_ptr<PrefChangeRegistrar>> registrars_;
+  base::ScopedMultiSourceObservation<Profile, ProfileObserver>
+      profile_observations_{this};
+  bool propagating_ = false;
+};
+
+}  // namespace
+
+void RegisterGlobalAppearanceLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kGlobalAppearancePref);
+}
+
+void AttachGlobalAppearance(Profile* profile) {
+  GlobalAppearance::Get().Attach(profile);
+}
+
+}  // namespace leto
