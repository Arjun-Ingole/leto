+#ifndef CHROME_BROWSER_UI_VIEWS_LETO_GLOBAL_APPEARANCE_H_
+#define CHROME_BROWSER_UI_VIEWS_LETO_GLOBAL_APPEARANCE_H_
+
+class PrefRegistrySimple;
+class Profile;
+
+namespace leto {
+
+// Appearance settings (layout, zen mode, sidebar, theme colors, ...) are
+// shared by every profile, so that all spaces look like one browser. A change
+// made in any profile is copied to the other loaded profiles and remembered in
+// local state for profiles that are loaded later.
+
+void RegisterGlobalAppearanceLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Applies the shared appearance to `profile` and keeps it in sync from now on.
+void AttachGlobalAppearance(Profile* profile);
+
+}  // namespace leto
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LETO_GLOBAL_APPEARANCE_H_
