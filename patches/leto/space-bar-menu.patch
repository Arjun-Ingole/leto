+// Opens the settings of the space at `profile_path`, where its name and icon
+// are edited, switching to it first if it is another space.
+void EditSpace(BrowserWindowInterface* browser,
+               const base::FilePath& profile_path) {
+  SwitchToSpace(
+      browser, profile_path, base::BindOnce([](BrowserWindowInterface* space) {
+        chrome::ShowSettingsSubPage(space, chrome::kManageProfileSubPage);
+      }));
+}
+
+// Adds a space with the next free "Space N" name and an unused icon, switches
+// to it and opens its settings, so it can be named right away.
+void CreateNewSpace(BrowserWindowInterface* browser) {
+  ProfileAttributesStorage& storage = GetStorage();
+  std::u16string name;
+  for (size_t number = storage.GetNumberOfProfiles() + 1;; ++number) {
+    name = u"Space " + base::NumberToString16(number);
+    const std::vector<ProfileAttributesEntry*> entries =
+        storage.GetAllProfilesAttributes();
+    if (std::ranges::none_of(entries, [&](const ProfileAttributesEntry* entry) {
+          return entry->GetLocalProfileName() == name;
+        })) {
+      break;
+    }
+  }
+
+  ProfileManager::CreateMultiProfileAsync(
+      name, storage.ChooseAvatarIconIndexForNewProfile(),
+      /*is_hidden=*/false,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser, Profile* profile) {
+            if (!browser || !profile) {
+              return;
+            }
+            EditSpace(browser.get(), profile->GetPath());
+          },
+          browser->GetWeakPtr()));
+}
+
