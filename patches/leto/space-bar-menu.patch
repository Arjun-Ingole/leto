+void SpaceBarView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto* button = views::AsViewClass<SpaceButton>(source);
+  menu_space_path_ = button ? button->profile_path() : base::FilePath();
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  if (button) {
+    menu_model_->AddItem(kEditSpace, u"Edit Space\u2026");
+    menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  }
+  menu_model_->AddItem(kNewSpace, u"New Space");
+  menu_model_->AddItem(kManageSpaces, u"Manage Spaces\u2026");
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void SpaceBarView::ExecuteCommand(int command_id, int event_flags) {
+  switch (command_id) {
+    case kEditSpace:
+      if (!menu_space_path_.empty()) {
+        EditSpace(browser_, menu_space_path_);
+      }
+      break;
+    case kNewSpace:
+      CreateNewSpace(browser_);
+      break;
+    case kManageSpaces:
+      ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+          ProfilePicker::EntryPoint::kProfileMenuManageProfiles));
+      break;
+  }
+}
