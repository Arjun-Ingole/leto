+// Spaces opened ahead of time whose windows stay hidden until switched to,
+// with the switches waiting for windows that aren't ready yet.
+struct Prewarm {
+  bool ready = false;
+  std::vector<base::OnceCallback<void(BrowserWindowInterface*)>> waiters;
+};
+std::map<base::FilePath, Prewarm>& Prewarms() {
+  static base::NoDestructor<std::map<base::FilePath, Prewarm>> prewarms;
+  return *prewarms;
+}
