+void PrewarmSpace(const base::FilePath& profile_path) {
+  if (Prewarms().contains(profile_path)) {
+    return;
+  }
+  Prewarms()[profile_path];
+  profiles::LoadProfileAsync(
+      profile_path,
+      base::BindOnce(
+          [](const base::FilePath& profile_path, Profile* profile) {
+            if (BrowserWindowInterface* existing =
+                    ProfileBrowserCollection::GetForProfile(profile)
+                        ->FindTabbedBrowser()) {
+              OnPrewarmed(profile_path, existing);
+              return;
+            }
+            profiles::OpenBrowserWindowForProfile(
+                base::BindOnce(&OnPrewarmed, profile_path),
+                /*always_create=*/false, /*is_new_profile=*/false,
+                /*open_command_line_urls=*/false, profile);
+          },
+          profile_path));
+}
+
+bool IsPrewarmingSpace(BrowserWindowInterface* browser) {
+  return browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+         !browser->GetProfile()->IsOffTheRecord() &&
+         Prewarms().contains(browser->GetProfile()->GetPath());
+}
