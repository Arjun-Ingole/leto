+void OnPrewarmed(const base::FilePath& profile_path,
+                 BrowserWindowInterface* browser) {
+  auto it = Prewarms().find(profile_path);
+  if (it == Prewarms().end()) {
+    return;
+  }
+  if (!browser) {
+    Prewarms().erase(it);
+    return;
+  }
+  it->second.ready = true;
+  // A switch arrived while the window was being opened; finish it now.
+  auto waiters = std::move(it->second.waiters);
+  for (auto& waiter : waiters) {
+    std::move(waiter).Run(browser);
+  }
+}
