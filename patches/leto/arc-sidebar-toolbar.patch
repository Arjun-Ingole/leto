+// Top of the sidebar in place of the toolbar, as in Arc: back, forward and
+// reload next to the window controls, and below them a pill with the current
+// site that opens the address bar, copies the link or shows site controls.
+class SidebarHeaderView : public views::View,
+                          public TabStripModelObserver,
+                          public content::WebContentsObserver,
+                          public CommandObserver {
+  METADATA_HEADER(SidebarHeaderView, views::View)
+
+ public:
+  explicit SidebarHeaderView(BrowserWindowInterface* browser);
+  SidebarHeaderView(const SidebarHeaderView&) = delete;
+  SidebarHeaderView& operator=(const SidebarHeaderView&) = delete;
+  ~SidebarHeaderView() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void TitleWasSet(content::NavigationEntry* entry) override;
+
+  // CommandObserver:
+  void EnabledStateChangedForCommand(int id, bool enabled) override;
+
+ private:
+  void UpdateVisibility();
+  void UpdateSite();
+  void ShowSiteControls();
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::ImageButton> back_button_ = nullptr;
+  raw_ptr<views::ImageButton> forward_button_ = nullptr;
+  raw_ptr<views::ImageButton> reload_button_ = nullptr;
+  raw_ptr<views::LabelButton> site_button_ = nullptr;
+  raw_ptr<views::ImageButton> copy_button_ = nullptr;
+  raw_ptr<views::ImageButton> controls_button_ = nullptr;
+
+  bool collapsed_ = false;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::CallbackListSubscription collapsed_subscription_;
+};
+
+}  // namespace leto
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LETO_SIDEBAR_HEADER_VIEW_H_
