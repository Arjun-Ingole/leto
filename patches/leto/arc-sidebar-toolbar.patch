+namespace {
+
+// The macOS window controls sit in the top left corner of the sidebar; the
+// navigation buttons share their row.
+constexpr int kNavRowHeight = 30;
+constexpr int kNavButtonSize = 28;
+constexpr int kNavIconSize = 16;
+constexpr int kPillHeight = 34;
+constexpr int kPillButtonSize = 26;
+constexpr int kPillIconSize = 14;
+constexpr int kPillCornerRadius = 10;
+constexpr int kSpacing = 8;
+
+// TODO(leto): Localize.
+constexpr char16_t kPlaceholder[] = u"Search or Enter URL...";
+
+std::unique_ptr<views::ImageButton> MakeIconButton(
+    const gfx::VectorIcon& icon,
+    int button_size,
+    int icon_size,
+    std::u16string_view tooltip,
+    views::Button::PressedCallback callback) {
+  auto button = std::make_unique<views::ImageButton>(std::move(callback));
+  button->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(icon, kColorToolbarButtonIcon, icon_size));
+  button->SetImageModel(views::Button::STATE_DISABLED,
+                        ui::ImageModel::FromVectorIcon(
+                            icon, kColorToolbarButtonIconInactive, icon_size));
+  button->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  button->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  button->SetPreferredSize(gfx::Size(button_size, button_size));
+  button->SetTooltipText(std::u16string(tooltip));
+  button->GetViewAccessibility().SetName(std::u16string(tooltip));
+  ConfigureInkDrop(button.get());
+  return button;
+}
+
+// The text for the site pill: the host for web pages, the title otherwise.
+std::u16string SiteText(content::WebContents* contents) {
+  const GURL& url = contents->GetVisibleURL();
+  if (url.SchemeIsHTTPOrHTTPS()) {
+    std::string_view host = url.host();
+    if (base::StartsWith(host, "www.")) {
+      host.remove_prefix(4);
+    }
+    return base::UTF8ToUTF16(host);
+  }
+  if (url.is_empty() || url.host() == chrome::kChromeUINewTabHost) {
+    return std::u16string();
+  }
+  const std::u16string& title = contents->GetTitle();
+  return title.empty() ? base::UTF8ToUTF16(url.spec()) : title;
+}
+
+}  // namespace
+
+SidebarHeaderView::SidebarHeaderView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kSpacing));
+
+  // Back, forward and reload, right of the window controls.
+  auto* nav_row = AddChildView(std::make_unique<views::View>());
+  auto* nav_layout =
+      nav_row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal));
+  nav_layout->set_main_axis_alignment(
+      views::BoxLayout::MainAxisAlignment::kEnd);
+  nav_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  nav_layout->set_minimum_cross_axis_size(kNavRowHeight);
+
+  auto command = [](BrowserWindowInterface* browser, int id) {
+    return base::BindRepeating(
+        [](BrowserWindowInterface* browser, int id) {
+          chrome::ExecuteCommand(browser, id);
+        },
+        browser, id);
+  };
+  // TODO(leto): Localize the tooltips.
+  back_button_ = nav_row->AddChildView(
+      MakeIconButton(vector_icons::kArrowBackIcon, kNavButtonSize, kNavIconSize,
+                     u"Back", command(browser_, IDC_BACK)));
+  forward_button_ = nav_row->AddChildView(
+      MakeIconButton(vector_icons::kArrowForwardIcon, kNavButtonSize,
+                     kNavIconSize, u"Forward", command(browser_, IDC_FORWARD)));
+  reload_button_ = nav_row->AddChildView(
+      MakeIconButton(vector_icons::kRefreshIcon, kNavButtonSize, kNavIconSize,
+                     u"Reload", command(browser_, IDC_RELOAD)));
+
+  // The site pill.
+  auto* pill = AddChildView(std::make_unique<views::View>());
+  pill->SetBackground(views::CreateRoundedRectBackground(
+      kColorToolbarBackgroundSubtleEmphasis, kPillCornerRadius));
+  auto* pill_layout = pill->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 4)));
+  pill_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  pill_layout->set_minimum_cross_axis_size(kPillHeight);
+
+  site_button_ = pill->AddChildView(std::make_unique<views::LabelButton>(
+      command(browser_, IDC_FOCUS_LOCATION), std::u16string()));
+  site_button_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  site_button_->SetLabelStyle(views::style::STYLE_BODY_4);
+  site_button_->SetMinSize(gfx::Size(0, kPillButtonSize));
+  site_button_->SetTooltipText(u"Edit address");
+  pill_layout->SetFlexForView(site_button_, 1);
+
+  copy_button_ = pill->AddChildView(
+      MakeIconButton(vector_icons::kLinkIcon, kPillButtonSize, kPillIconSize,
+                     u"Copy link", command(browser_, IDC_COPY_URL)));
+  controls_button_ = pill->AddChildView(MakeIconButton(
+      vector_icons::kTuneIcon, kPillButtonSize, kPillIconSize, u"Site controls",
+      base::BindRepeating(&SidebarHeaderView::ShowSiteControls,
+                          base::Unretained(this))));
+
+  for (int id : {IDC_BACK, IDC_FORWARD}) {
+    chrome::AddCommandObserver(browser_, id, this);
+    EnabledStateChangedForCommand(id, chrome::IsCommandEnabled(browser_, id));
+  }
+
+  browser_->GetTabStripModel()->AddObserver(this);
+  Observe(browser_->GetTabStripModel()->GetActiveWebContents());
+  UpdateSite();
+
+  if (auto* state_controller =
+          tabs::VerticalTabStripStateController::From(browser_)) {
+    collapsed_ = state_controller->GetCollapseState() !=
+                 tabs::VerticalTabStripCollapseState::kExpanded;
+    collapsed_subscription_ =
+        state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+            [](SidebarHeaderView* view,
+               tabs::VerticalTabStripCollapseState state) {
+              view->collapsed_ =
+                  state != tabs::VerticalTabStripCollapseState::kExpanded;
+              view->UpdateVisibility();
+            },
+            base::Unretained(this)));
+  }
+
+  pref_change_registrar_.Init(browser_->GetProfile()->GetPrefs());
+  for (const char* pref :
+       {prefs::kHeliumZenMode, prefs::kHeliumZenModeTopChromePinned}) {
+    pref_change_registrar_.Add(
+        pref, base::BindRepeating(&SidebarHeaderView::UpdateVisibility,
+                                  base::Unretained(this)));
+  }
+  UpdateVisibility();
+}
+
+SidebarHeaderView::~SidebarHeaderView() {
+  for (int id : {IDC_BACK, IDC_FORWARD}) {
+    chrome::RemoveCommandObserver(browser_, id, this);
+  }
+  browser_->GetTabStripModel()->RemoveObserver(this);
+}
+
+void SidebarHeaderView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Observe(selection.new_contents);
+    UpdateSite();
+  }
+}
+
+void SidebarHeaderView::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  // Includes same document navigations, which single page apps use.
+  if (navigation_handle->IsInPrimaryMainFrame()) {
+    UpdateSite();
+  }
+}
+
+void SidebarHeaderView::TitleWasSet(content::NavigationEntry* entry) {
+  UpdateSite();
+}
+
+void SidebarHeaderView::EnabledStateChangedForCommand(int id, bool enabled) {
+  if (id == IDC_BACK) {
+    back_button_->SetEnabled(enabled);
+  } else if (id == IDC_FORWARD) {
+    forward_button_->SetEnabled(enabled);
+  }
+}
+
+void SidebarHeaderView::UpdateVisibility() {
+  // The header replaces the toolbar, which is only hidden in zen mode.
+  const PrefService* prefs = browser_->GetProfile()->GetPrefs();
+  SetVisible(prefs->GetBoolean(prefs::kHeliumZenMode) &&
+             !prefs->GetBoolean(prefs::kHeliumZenModeTopChromePinned) &&
+             !collapsed_);
+}
+
+void SidebarHeaderView::UpdateSite() {
+  content::WebContents* contents = web_contents();
+  const std::u16string text = contents ? SiteText(contents) : std::u16string();
+  const bool is_placeholder = text.empty();
+
+  site_button_->SetText(is_placeholder ? kPlaceholder : text);
+  site_button_->SetEnabledTextColors(is_placeholder ? kColorOmniboxTextDimmed
+                                                    : kColorOmniboxText);
+  copy_button_->SetVisible(!is_placeholder);
+  controls_button_->SetVisible(!is_placeholder);
+}
+
+void SidebarHeaderView::ShowSiteControls() {
+  // TODO(leto): Replace with an Arc style popover with quick actions and
+  // extensions.
+  content::WebContents* contents = web_contents();
+  if (!contents) {
+    return;
+  }
+  content::NavigationEntry* entry = contents->GetController().GetVisibleEntry();
+  if (!entry || entry->IsInitialEntry()) {
+    return;
+  }
+
+  views::BubbleDialogDelegateView* bubble =
+      PageInfoBubbleView::CreatePageInfoBubble(
+          PageInfoBubbleSpecification::Builder(
+              views::BubbleAnchor(controls_button_.get()),
+              GetWidget()->GetNativeWindow(), contents, entry->GetVirtualURL())
+              .Build());
+  bubble->SetArrow(views::BubbleBorder::LEFT_TOP);
+  bubble->GetWidget()->Show();
+}
+
+BEGIN_METADATA(SidebarHeaderView)
+END_METADATA
