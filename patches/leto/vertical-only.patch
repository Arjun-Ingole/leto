+
+void HeliumLayoutStateController::EnforceVerticalLayout() {
+  // Leto only has the vertical layout, with the sidebar on the left.
+  if (pref_service_->GetInteger(prefs::kHeliumLayout) !=
+      std::to_underlying(HeliumLayoutType::kVertical)) {
+    pref_service_->SetInteger(prefs::kHeliumLayout,
+                              std::to_underlying(HeliumLayoutType::kVertical));
+  }
+  if (pref_service_->GetBoolean(prefs::kHeliumVerticalRightAligned)) {
+    pref_service_->SetBoolean(prefs::kHeliumVerticalRightAligned, false);
+  }
 }
 
