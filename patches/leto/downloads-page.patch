+      var(--cr-primary-text-color) 6%, transparent);
+  --cr-focus-outline-color: color-mix(in srgb, var(--cr-primary-text-color) 22%,
+      transparent);
 }
 
 downloads-item,
 #downloadsList,
 cr-toast-manager {
-  --downloads-card-margin: 24px;
-  --downloads-card-width: clamp(550px, 80%, 680px);
+  --downloads-card-margin: 16px;
+  --downloads-card-width: clamp(480px, 80%, 640px);
   --cr-toast-max-width: var(--downloads-card-width);
 }
 
--- a/chrome/browser/resources/downloads/toolbar.css
+++ b/chrome/browser/resources/downloads/toolbar.css
@@ -20,6 +20,20 @@
   min-width: 0;
 }
 
+/* Leto: a quiet text button, like the "Show all" in the downloads bubble. */
 #clearAll {
+  --cr-hover-background-color: color-mix(in srgb,
+      var(--cr-primary-text-color) 6%, transparent);
+  background: transparent;
+  border: none;
+  border-radius: 8px;
+  color: var(--cr-secondary-text-color);
+  font-weight: 500;
+  height: 30px;
+  padding: 0 10px;
   white-space: nowrap;
 }
+
+#clearAll:hover {
+  color: var(--cr-primary-text-color);
+}
