+// Tells the active tab of `browser` that it is shown or hidden along with its
+// space, so a playing video moves into picture-in-picture as its space is left
+// and back out when it returns, as it does on tab switches.
+void SetActiveTabShown(BrowserWindowInterface* browser, bool shown) {
+  content::WebContents* contents =
+      browser ? browser->GetTabStripModel()->GetActiveWebContents() : nullptr;
+  if (auto* helper =
+          contents ? AutoPictureInPictureTabHelper::FromWebContents(contents)
+                   : nullptr) {
+    helper->OnTabActivatedChanged(shown);
+  }
+}
