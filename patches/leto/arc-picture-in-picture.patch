+bool ShowSpace(BrowserWindowInterface* browser) {
+  BrowserWindow* window = BrowserWindow::FromBrowser(browser);
+  if (!window || window->IsVisible() ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  // The space on screen is the most recently active visible window of another
+  // profile.
+  BrowserWindowInterface* shown = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* other) {
+        BrowserWindow* other_window = BrowserWindow::FromBrowser(other);
+        if (other != browser &&
+            other->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+            other->GetProfile() != browser->GetProfile() && other_window &&
+            other_window->IsVisible()) {
+          shown = other;
+          return false;
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+  if (!shown) {
+    return false;
+  }
+  PresentInPlace(shown->GetWeakPtr(),
+                 BrowserWindow::FromBrowser(shown)->GetBounds(), browser);
+  return true;
+}
