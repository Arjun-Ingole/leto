+
+#ifndef CHROME_BROWSER_UI_VIEWS_LETO_CLEAN_URL_H_
+#define CHROME_BROWSER_UI_VIEWS_LETO_CLEAN_URL_H_
+
+class GURL;
+
+namespace leto {
+
+// Returns `url` without the query parameters that only exist to track who
+// shared it and where it was clicked (utm_*, fbclid, gclid, YouTube's si and
+// the like), for links Leto copies. Other parameters keep their order and
+// encoding.
+GURL RemoveTrackingParameters(const GURL& url);
+
+}  // namespace leto
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LETO_CLEAN_URL_H_
