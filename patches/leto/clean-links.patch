+// Copyright 2026 The Leto Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/leto/clean_url.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/fixed_flat_set.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "url/gurl.h"
+
+namespace leto {
+
+namespace {
+
+// Click and campaign identifiers added by ad networks, mailing tools and
+// social sites. They never change what the page shows.
+constexpr auto kTrackingParameters = base::MakeFixedFlatSet<std::string_view>({
+    "_hsenc",     "_hsmi",         "_openstat", "__hsfp",  "__hssc",
+    "__hstc",     "dclid",         "fbclid",    "gbraid",  "gclid",
+    "gclsrc",     "hsCtaTracking", "igsh",      "igshid",  "li_fat_id",
+    "mc_cid",     "mc_eid",        "mkt_tok",   "msclkid", "oly_anon_id",
+    "oly_enc_id", "rb_clickid",    "s_cid",     "srsltid", "ttclid",
+    "twclid",     "vero_conv",     "vero_id",   "wbraid",  "wickedid",
+    "yclid",
+});
+
+// Parameters that are only tracking on particular sites, where a generic name
+// like "si" is the share identifier.
+bool IsSiteTrackingParameter(std::string_view host, std::string_view key) {
+  if (base::StartsWith(host, "www.")) {
+    host.remove_prefix(4);
+  }
+  if (host == "youtube.com" || host == "m.youtube.com" ||
+      host == "music.youtube.com" || host == "youtu.be") {
+    return key == "si" || key == "pp" || key == "feature";
+  }
+  if (host == "open.spotify.com") {
+    return key == "si" || key == "context";
+  }
+  if (host == "x.com" || host == "twitter.com") {
+    return key == "s" || key == "t" || key == "ref_src" || key == "ref_url";
+  }
+  return false;
+}
+
+bool IsTrackingParameter(std::string_view host, std::string_view key) {
+  return base::StartsWith(key, "utm_") ||
+         kTrackingParameters.contains(key) ||
+         IsSiteTrackingParameter(host, key);
+}
+
+}  // namespace
+
+GURL RemoveTrackingParameters(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS() || !url.has_query()) {
+    return url;
+  }
+  std::vector<std::string_view> kept;
+  bool removed = false;
+  for (std::string_view part :
+       base::SplitStringPiece(url.query(), "&", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (IsTrackingParameter(url.host(), part.substr(0, part.find('=')))) {
+      removed = true;
+    } else {
+      kept.push_back(part);
+    }
+  }
+  if (!removed) {
+    return url;
+  }
+  const std::string query = base::JoinString(kept, "&");
+  GURL::Replacements replacements;
+  if (query.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+}  // namespace leto
