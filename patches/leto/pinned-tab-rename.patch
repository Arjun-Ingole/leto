+constexpr int kFieldCornerRadius = 6;
+
+// A tab's own name, set by the user.
+class CustomTabTitle : public content::WebContentsUserData<CustomTabTitle> {
+ public:
+  ~CustomTabTitle() override = default;
+
+  const std::u16string& title() const { return title_; }
+  void set_title(const std::u16string& title) { title_ = title; }
+
+ private:
+  friend class content::WebContentsUserData<CustomTabTitle>;
+  explicit CustomTabTitle(content::WebContents* contents)
+      : content::WebContentsUserData<CustomTabTitle>(*contents) {}
+
+  std::u16string title_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(CustomTabTitle);
+
+TabView* FindTabView(views::View* root, const tabs::TabInterface* tab) {
+  if (auto* tab_view = views::AsViewClass<TabView>(root);
+      tab_view && tab_view->GetTabInterface() == tab) {
+    return tab_view;
+  }
+  for (views::View* child : root->children()) {
+    if (TabView* found = FindTabView(child, tab)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+TabTitle* FindTitle(TabView* tab_view) {
+  for (views::View* child : tab_view->children()) {
+    if (auto* title = views::AsViewClass<TabTitle>(child)) {
+      return title;
+    }
+  }
+  return nullptr;
+}
+
+// The field that takes the place of a tab's title while it's being named.
+// Return or clicking away keeps the name, and Escape leaves it as it was.
+class RenameField : public views::Textfield, public views::TextfieldController {
+  METADATA_HEADER(RenameField, views::Textfield)
+
+ public:
+  explicit RenameField(content::WebContents* contents)
+      : contents_(contents->GetWeakPtr()) {
+    set_controller(this);
+    SetProperty(views::kViewIgnoredByLayoutKey, true);
+    // The title paints to a layer of its own; the field must sit above it.
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 4)));
+    SetBackground(views::CreateRoundedRectBackground(
+        kColorToolbarBackgroundSubtleEmphasis, kFieldCornerRadius));
+    SetAccessibleName(u"Tab name");
+  }
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override {
+    if (key_event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (key_event.key_code() == ui::VKEY_RETURN) {
+      Finish(/*keep=*/true);
+      return true;
+    }
+    if (key_event.key_code() == ui::VKEY_ESCAPE) {
+      Finish(/*keep=*/false);
+      return true;
+    }
+    return false;
+  }
+
+  // views::Textfield:
+  void OnBlur() override {
+    views::Textfield::OnBlur();
+    Finish(/*keep=*/true);
+  }
+
+ private:
+  void Finish(bool keep) {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    if (keep && contents_) {
+      std::u16string name(base::TrimWhitespace(GetText(), base::TRIM_ALL));
+      // A name that is just the page's title is no name at all.
+      if (name == contents_->GetTitle()) {
+        name.clear();
+      }
+      SetCustomTabTitle(contents_.get(), name);
+      // Show the new name at once rather than at the page's next change.
+      if (TabView* tab_view = views::AsViewClass<TabView>(parent())) {
+        if (TabTitle* title = FindTitle(tab_view)) {
+          title->SetText(name.empty() ? contents_->GetTitle() : name);
+        }
+      }
+    }
+    // The field goes once the event that ended it has been handled.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<views::View> field) {
+                         if (field && field->parent()) {
+                           field->parent()->RemoveChildViewT(field.get());
+                         }
+                       },
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  base::WeakPtr<content::WebContents> contents_;
+  bool finished_ = false;
+  base::WeakPtrFactory<views::View> weak_factory_{this};
+};
+
+BEGIN_METADATA(RenameField)
+END_METADATA
+
+}  // namespace
+
+std::optional<std::u16string> GetCustomTabTitle(
+    const content::WebContents* contents) {
+  const CustomTabTitle* custom = CustomTabTitle::FromWebContents(
+      const_cast<content::WebContents*>(contents));
+  if (!custom || custom->title().empty()) {
+    return std::nullopt;
+  }
+  return custom->title();
+}
+
+void SetCustomTabTitle(content::WebContents* contents,
+                       const std::u16string& title) {
+  if (title.empty()) {
+    contents->RemoveUserData(CustomTabTitle::UserDataKey());
+  } else {
+    CustomTabTitle::CreateForWebContents(contents);
+    CustomTabTitle::FromWebContents(contents)->set_title(title);
+  }
+
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (SessionService* session_service =
+          SessionServiceFactory::GetForProfile(profile)) {
+    const SessionID window_id =
+        sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (window_id.is_valid() && tab_id.is_valid()) {
+      session_service->AddTabExtraData(window_id, tab_id, kCustomTabTitleKey,
+                                       base::UTF16ToUTF8(title));
+    }
+  }
+
+  if (tabs::TabInterface* tab =
+          tabs::TabInterface::MaybeGetFromContents(contents)) {
+    if (BrowserWindowInterface* browser = tab->GetBrowserWindowInterface()) {
+      browser->GetTabStripModel()->NotifyTabChanged(tab, TabChangeType::kAll);
+    }
+  }
+}
+
+void RestoreCustomTabTitle(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto it = extra_data.find(kCustomTabTitleKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return;
+  }
+  CustomTabTitle::CreateForWebContents(contents);
+  CustomTabTitle::FromWebContents(contents)->set_title(
+      base::UTF8ToUTF16(it->second));
+}
+
+void StartRenamingTab(tabs::TabInterface* tab) {
+  BrowserWindowInterface* browser =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  BrowserView* browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  TabView* tab_view = browser_view ? FindTabView(browser_view, tab) : nullptr;
+  TabTitle* title = tab_view ? FindTitle(tab_view) : nullptr;
+  if (!title) {
+    return;
+  }
+
+  auto* field =
+      tab_view->AddChildView(std::make_unique<RenameField>(tab->GetContents()));
+  field->SetFontList(title->font_list());
+  field->SetText(std::u16string(title->GetText()));
+  // Cover the title, reaching a little either side of it so the text inside
+  // the field lines up with the title's.
+  gfx::Rect bounds = title->bounds();
+  bounds.Outset(gfx::Outsets::VH(2, 4));
+  field->SetBoundsRect(bounds);
+  field->SelectAll(/*reversed=*/false);
+  field->RequestFocus();
+}
+
