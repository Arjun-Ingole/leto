+
+// Pinned tabs can be given names of their own, as in Arc, which the sidebar
+// shows in place of the page's title. Names are kept with the session.
+
+// The tab menu's "Rename Tab…" command. It lies beyond Chromium's own tab
+// commands.
+inline constexpr int kRenameTabCommandId = 1000;
+
+// The session's key for a tab's name.
+inline constexpr char kCustomTabTitleKey[] = "leto.custom_title";
+
+// The name given to the tab of `contents`, if any.
+std::optional<std::u16string> GetCustomTabTitle(
+    const content::WebContents* contents);
+
+// Names the tab of `contents` `title`, or forgets its name if `title` is
+// empty, and saves it with the session.
+void SetCustomTabTitle(content::WebContents* contents,
+                       const std::u16string& title);
+
+// Gives a restored tab the name it was saved with.
+void RestoreCustomTabTitle(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data);
+
+// Turns `tab`'s title in the sidebar into a field for naming it.
+void StartRenamingTab(tabs::TabInterface* tab);
+
+}  // namespace leto
