+// Remembers which emoji the profile's custom avatar was drawn from, so that it
+// can be shown as selected. Settings storage is separate for every profile.
+const EMOJI_STORAGE_KEY = 'leto.avatarEmoji';
+
+// Draws `emoji` with the system emoji font into a transparent square image.
+function renderEmojiAvatar(emoji: string): string {
+  const size = 256;
+  const canvas = document.createElement('canvas');
+  canvas.width = size;
+  canvas.height = size;
+  const context = canvas.getContext('2d')!;
+  context.textAlign = 'center';
+  context.textBaseline = 'middle';
+  // Avatars are cropped to a circle, so keep the glyph inside it.
+  context.font = `${Math.round(size * 0.64)}px "Apple Color Emoji", ` +
+      `"Noto Color Emoji", sans-serif`;
+  context.fillText(emoji, size / 2, size / 2 + size * 0.04);
+  return canvas.toDataURL('image/png');
+}
+
+// Returns the first emoji in `text`, or null if it does not start with one.
+function firstEmoji(text: string): string|null {
+  const segmenter = new Intl.Segmenter(undefined, {granularity: 'grapheme'});
+  for (const {segment} of segmenter.segment(text.trim())) {
+    return /\p{Extended_Pictographic}/u.test(segment) ? segment : null;
+  }
+  return null;
+}
